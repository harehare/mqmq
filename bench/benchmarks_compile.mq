# Run with: mq-bench bench/benchmarks_compile.mq --iterations 10 --warmup 2
# Cost of compiling a parsed AST into closures, separate from evaluating it.
# A one-shot query pays this once; a reused query (mqmq_compile) pays it once
# for any number of evaluations.

import "lexer" as lexer
| import "parser" as parser
| import "eval" as eval
| let chain_ast = parser::mq_parse(lexer::lex(join(map(range(1, 256), fn(i): to_string(i) end), " + ")))
| let pipe_ast = parser::mq_parse(lexer::lex("1" + join(map(range(1, 512), fn(i): " | . + 1" end), "")))
| let fib_ast = parser::mq_parse(lexer::lex("def fib(n): if (n < 2): n else: fib(n - 1) + fib(n - 2) end | fib(20)"))
| let dict_ast = parser::mq_parse(lexer::lex("{" + join(map(range(0, 255), fn(i): "k" + to_string(i) + ": " + to_string(i) end), ", ") + "}"))
| let call_ast = parser::mq_parse(lexer::lex("let xs = [1, 2, 3] | let n = len(xs) | if (n > 2): to_string(n) + \"!\" else: \"short\""))
|

# Module setup (imports and parsing) runs on every iteration; subtract this.
def bench_setup_only():
  None
end

def bench_compile_chain_256():
  eval::mq_compile(chain_ast)
end

def bench_compile_pipe_512():
  eval::mq_compile(pipe_ast)
end

def bench_compile_fib():
  eval::mq_compile(fib_ast)
end

def bench_compile_dict_256():
  eval::mq_compile(dict_ast)
end

def bench_compile_small_query_repeated():
  foreach (i, range(0, 99)):
    eval::mq_compile(call_ast)
  end
end
