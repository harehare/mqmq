# mqmq/lexer.mq
# Tokenizer for the mq language, written in mq.
#
# Token shape: {t: <type>, v: <value>}
# Types:
#   kw    - keyword (def, fn, let, var, if, elif, else, end, do, while, foreach, ...)
#   ident - identifier
#   str   - string literal
#   num   - number literal (as string, converted in parser)
#   bool  - boolean literal value as string ("true"/"false")
#   none  - None literal
#   atom  - atom like :foo
#   sel   - selector like .h1  (value = "h1")
#   dot   - bare dot "."
#   op    - operator/punctuation

## Keyword lookup table, built once at module load (not per call) and checked
## with an O(1) dict lookup instead of a linear `contains` scan over an array
## rebuilt on every call.
let _KWS = {
  "def": true, "fn": true, "let": true, "var": true, "if": true, "elif": true,
  "else": true, "end": true, "do": true, "while": true, "until": true,
  "unless": true, "foreach": true, "in": true, "import": true, "include": true,
  "module": true, "match": true, "break": true, "continue": true, "loop": true,
  "try": true, "catch": true, "self": true, "nodes": true,
}
| let _TWO_OPS = {
  "||": true, "|=": true, "&&": true, "==": true, "=~": true,
  "!=": true, "!~": true, "<=": true, "<<": true, ">=": true,
  ">>": true, "+=": true, "-=": true, "->": true, "*=": true,
  "/=": true, "%=": true, "??": true,
}
## One alternative per token shape, tried in order: comment, selector, atom,
## word, number, the two string forms, then every multi-character operator.
## The final alternative takes any other single character except whitespace,
## so the matches cover everything but the whitespace between tokens.
| let _TOKEN_RE = "(?s)#[^\\n\\r]*|\\.[A-Za-z_][A-Za-z0-9_]*|:[A-Za-z_][A-Za-z0-9_]*|[A-Za-z_][A-Za-z0-9_]*|[0-9]+(?:\\.[0-9]+)?|\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'|//=|\\|\\||\\|=|&&|==|=~|!=|!~|<=|<<|>=|>>|\\+=|-=|->|\\*=|/=|%=|\\?\\?|\\.\\.|::|[^ \\t\\n\\r]"
## An `s"` that starts a word begins an interpolated string, which needs the
## character scanner to find its `${...}` segments.
| let _INTERP_RE = "(?:^|[^A-Za-z0-9_])s\""
|

## Direct range comparisons instead of `regex_match`: identifier/digit
## classification runs once per input character, and a regex-engine call
## (cache lookup + match) is far more expensive here than a couple of
## single-character string comparisons.
def _is_alpha(c):
  (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_"
end

def _is_digit(c):
  c >= "0" && c <= "9"
end

def _is_alnum(c):
  _is_alpha(c) || _is_digit(c)
end

def _is_ws(c):
  c == " " || c == "\t" || c == "\n" || c == "\r" || c == "\r\n"
end

def _tok(t, v):
  {t: t, v: v}
end

## Join a `[from, to)` slice of a char array back into a string. Indexing and
## slicing a *string* by character position costs mq's host runtime O(position)
## (it has to walk grapheme boundaries from the start each time), which makes a
## naive character-at-a-time scan over the raw query string quadratic in its
## length. `lex()` instead grapheme-splits the query into an array once up
## front (array indexing is O(1)) and reassembles substrings with this helper.
def _slice(chars, from, to):
  join(chars[from:to], "")
end

# Scan while characters satisfy pred_fn; return end index.
def _scan_while(chars, start, n, pred_fn):
  var j = start
  | while (j < n && pred_fn(chars[j])):
      j += 1
    end
  | j
end

# Skip a whole whitespace run without creating a result for each character.
def _scan_ws(chars, start, n):
  var j = start
  | while (j < n && _is_ws(chars[j])):
      j += 1
    end
  | j
end

def _scan_comment(chars, start, n):
  var j = start
  | while (j < n && chars[j] != "\n" && chars[j] != "\r" && chars[j] != "\r\n"):
      j += 1
    end
  | j
end

# Lex an escape sequence starting at position j (after the backslash).
def _lex_escape(chars, j, n):
  if (j >= n):
    {ch: "\\", j: j}
  else:
    let nc = chars[j]
    | if (nc == "n"):  {ch: "\n", j: j + 1}
      elif (nc == "t"):  {ch: "\t", j: j + 1}
      elif (nc == "\\"): {ch: "\\", j: j + 1}
      elif (nc == "\"" || nc == "'"): {ch: nc, j: j + 1}
      else: {ch: nc, j: j + 1}
end

# Scan a `${...}` expression body starting just past the opening brace.
# Braces inside strings and comments are data, not expression delimiters.
def _scan_until_brace(chars, start, n):
  var depth = 1
  | var k = start
  | var quote = ""
  | var in_comment = false
  | while (k < n && depth > 0):
      let c = chars[k]
      | if (in_comment) do
          if (c == "\n" || c == "\r" || c == "\r\n"): in_comment = false
          | k += 1
        end
        elif (!is_empty(quote)) do
          if (c == "\\" && k + 1 < n):
            k += 2
          else do
            if (c == quote): quote = ""
            | k += 1
          end
        end
        elif (c == "\"" || c == "'") do
          quote = c
          | k += 1
        end
        elif (c == "#") do
          in_comment = true
          | k += 1
        end
        elif (c == "{") do
          depth += 1
          | k += 1
        end
        elif (c == "}") do
          depth -= 1
          | if (depth > 0): k += 1
        end
        else:
          k += 1
    end
  | if (depth == 0): k else: error("Unclosed interpolation expression")
end

# Lex an interpolated string s"...${expr}..." starting at the opening quote
# (index i). Returns {segs: [{kind:"text",val} | {kind:"expr",val}], j: <end>}.
# Common case: an interpolated string with no escapes or expressions needs
# only one slice, rather than a character-by-character string build.
def _lex_interp_string(chars, i, n):
  var j = i + 1
  | while (j < n && chars[j] != "\"" && chars[j] != "\\" &&
           !(chars[j] == "$" && j + 1 < n && chars[j + 1] == "{")):
      j += 1
    end
  | if (j >= n || chars[j] == "\""):
      {segs: if (j == i + 1): [] else: [{kind: "text", val: _slice(chars, i + 1, j)}], j: j + 1}
    else:
      _lex_interp_string_complex(chars, i, n)
end

def _lex_interp_string_complex(chars, i, n):
  var j = i + 1
  | var segs = []
  | var buf = ""
  | while (j < n && chars[j] != "\""):
      if (chars[j] == "\\" && j + 1 < n) do
          let esc = _lex_escape(chars, j + 1, n)
          | buf += esc[:ch]
          | j = esc[:j]
        end
      elif (chars[j] == "$" && j + 1 < n && chars[j + 1] == "{") do
          if (!is_empty(buf)) do
              segs += [{kind: "text", val: buf}]
              | buf = ""
            end
          | let k = _scan_until_brace(chars, j + 2, n)
          | segs += [{kind: "expr", val: _slice(chars, j + 2, k)}]
          | j = k + 1
        end
      else do
        buf += chars[j]
        | j += 1
      end
    end
  | if (!is_empty(buf)):
      segs += [{kind: "text", val: buf}]
  | {segs: segs, j: j + 1}
end

## Scan one token, returning the token and the next unread character index.
## Whitespace and comments return no token.
def _lex_one(chars, i, n):
  let c = chars[i]
  | if (_is_ws(c)):
      {tok: None, next: _scan_ws(chars, i + 1, n)}
    elif (c == "#"):
      {tok: None, next: _scan_comment(chars, i + 1, n)}
    elif (c == ".") do
      if (i + 1 < n && _is_alpha(chars[i + 1])) do
        let j = _scan_while(chars, i + 1, n, _is_alnum)
        | {tok: _tok("sel", _slice(chars, i + 1, j)), next: j}
      end
      elif (i + 1 < n && chars[i + 1] == "."):
        {tok: _tok("op", ".."), next: i + 2}
      else:
        {tok: _tok("dot", "."), next: i + 1}
    end
    elif (c == ":") do
      if (i + 1 < n && chars[i + 1] == ":"):
        {tok: _tok("op", "::"), next: i + 2}
      elif (i + 1 < n && _is_alpha(chars[i + 1])) do
        let j = _scan_while(chars, i + 1, n, _is_alnum)
        | {tok: _tok("atom", _slice(chars, i + 1, j)), next: j}
      end
      else:
        {tok: _tok("op", ":"), next: i + 1}
    end
    elif (c == "s" && i + 1 < n && chars[i + 1] == "\"") do
      let r = _lex_interp_string(chars, i + 1, n)
      | {tok: _tok("istr", r[:segs]), next: r[:j]}
    end
    elif (_is_alpha(c)) do
      let j = _scan_while(chars, i, n, _is_alnum)
      | let word = _slice(chars, i, j)
      | let tok = if (word == "true" || word == "false"):
                    _tok("bool", word)
                  elif (word == "None"):
                    _tok("none", "")
                  elif (!is_none(_KWS[word])):
                    _tok("kw", word)
                  else:
                    _tok("ident", word)
      | {tok: tok, next: j}
    end
    elif (_is_digit(c)) do
      var j = _scan_while(chars, i, n, _is_digit)
      | if (j < n && chars[j] == "." && j + 1 < n && _is_digit(chars[j + 1])):
          j = _scan_while(chars, j + 1, n, _is_digit)
      | {tok: _tok("num", _slice(chars, i, j)), next: j}
    end
    elif (c == "\"" || c == "'") do
      let delim = c
      | var j = i + 1
      | while (j < n && chars[j] != delim && chars[j] != "\\"):
          j += 1
        end
      | if (j >= n || chars[j] == delim):
          {tok: _tok("str", _slice(chars, i + 1, j)), next: j + 1}
        else do
          let prefix = _slice(chars, i + 1, j)
          | let suffix = foreach (pos, range(j, n - 1)):
              if (pos < j): continue
              elif (chars[pos] == delim): break
              elif (chars[pos] == "\\" && pos + 1 < n) do
                let esc = _lex_escape(chars, pos + 1, n)
                | j = esc[:j]
                | esc[:ch]
              end
              else do
                j = pos + 1
                | chars[pos]
              end
            end
          | {tok: _tok("str", prefix + join(suffix, "")), next: j + 1}
        end
    end
    else do
      let two = if (i + 1 < n): c + chars[i + 1] else: c
      | let op = if (two == "//" && i + 2 < n && chars[i + 2] == "="):
                   "//="
                 elif (!is_none(_TWO_OPS[two])):
                   two
                 else:
                   c
      | {tok: _tok("op", op), next: i + len(op)}
    end
end

## Tokenize an mq query string.
##
## Scanning a query one character at a time costs several interpreted calls
## per character. The host regex engine can split the query into lexemes in one
## native call instead, leaving only one classification step per lexeme.
## Queries the lexeme split can't represent exactly fall back to the
## character scanner: interpolated strings, unterminated strings, non-ASCII
## characters outside strings, and multi-code-point graphemes (regex matches
## are made of code points, while the character scanner works on graphemes).
def lex(query):
  let fast = if (is_regex_match(query, _INTERP_RE) || !_single_code_point_graphemes(query)): None
             else: _lex_lexemes(query)
  | if (is_none(fast)): _lex_chars(query) else: fast
end

## True when every grapheme other than "\r\n" is a single code point, so
## lexeme boundaries can't split a grapheme.
def _single_code_point_graphemes(query):
  if (is_regex_match(query, "[^\\x00-\\x7F]")):
    len(graphemes(query)) + len(regex_match(query, "\r\n")) == len(regex_match(query, "(?s)."))
  else: true
end

## Classify the lexemes of `_TOKEN_RE`. Returns None when the query needs the
## character scanner.
def _lex_lexemes(query):
  var ok = true
  | let toks = foreach (lx, regex_match(query, _TOKEN_RE)):
      # Character tests are inlined; this runs once per token.
      let c = lx[0]
      | if ((c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_"):
          if (lx == "true" || lx == "false"): {t: "bool", v: lx}
          elif (lx == "None"): {t: "none", v: ""}
          elif (!is_none(_KWS[lx])): {t: "kw", v: lx}
          else: {t: "ident", v: lx}
        elif (c >= "0" && c <= "9"): {t: "num", v: lx}
        elif (len(lx) == 1) do
          if (c == "."): {t: "dot", v: "."}
          elif (c == "\"" || c == "'" || c >= "\u{80}") do
            ok = false
            | break
          end
          else: {t: "op", v: c}
        end
        elif (c == "#"): continue
        elif (c == "\"" || c == "'") do
          let body = lx[1:len(lx) - 1]
          | {t: "str", v: if (contains(body, "\\")): _unescape(body) else: body}
        end
        elif (c == "." && lx != ".."): {t: "sel", v: lx[1:len(lx)]}
        elif (c == ":" && lx != "::"): {t: "atom", v: lx[1:len(lx)]}
        else: {t: "op", v: lx}
    end
  | if (ok): toks + [_tok("eof", "")] else: None
end

## Resolve the escape sequences in a string literal's body.
def _unescape(s):
  let chars = graphemes(s)
  | let n = len(chars)
  | var next = 0
  | join(foreach (pos, range(0, n - 1)):
      if (pos < next): continue
      elif (chars[pos] == "\\" && pos + 1 < n) do
        let esc = _lex_escape(chars, pos + 1, n)
        | next = esc[:j]
        | esc[:ch]
      end
      else: chars[pos]
    end, "")
end

## Tokenize by scanning characters. `foreach` collects emitted tokens in place;
## the index skips characters already consumed by a multi-character token.
def _lex_chars(query):
  let chars = graphemes(query)
  | let n = len(chars)
  | var next = 0
  | let toks = if (n == 0): []
               else: foreach (pos, range(0, n - 1)):
                 if (pos < next): continue
                 else do
                   let step = _lex_one(chars, pos, n)
                   | next = step[:next]
                   | if (is_none(step[:tok])): continue
                     else: step[:tok]
                 end
               end
  | toks + [_tok("eof", "")]
end
