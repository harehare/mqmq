# mqmq/parser_tests.mq
# Tests for the mqmq parser, run with `mq-test parser_tests.mq`.

import "lexer"
| import "parser"
| include "test"

def _parse(q): parser::mq_parse(lexer::lex(q)) end

# @parametrize([
#   ["1 + 2", {kind: "bin", op: "+", left: {kind: "num", val: 1}, right: {kind: "num", val: 2}}],
#   ["let x = 5", {kind: "let", name: "x", val: {kind: "num", val: 5}}],
#   [".h1", {kind: "sel", name: "h1"}],
#   ["break", {kind: "break", val: None}],
#   ["continue", {kind: "continue"}],
#   ["nodes", {kind: "nodes"}],
#   ["1..5", {kind: "bin", op: "..", left: {kind: "num", val: 1}, right: {kind: "num", val: 5}}],
#   ["\"x\" @ \"-\"", {kind: "bin", op: "@", left: {kind: "str", val: "x"}, right: {kind: "str", val: "-"}}],
#   # A string literal "-" must not be parsed as a unary-minus prefix.
#   ["\"-\"", {kind: "str", val: "-"}],
#   ["x //= 2", {kind: "assign", name: "x", op: "//=", val: {kind: "num", val: 2}}],
#   ["math::add(1, 2)", {kind: "call", name: "math::add", args: [{kind: "num", val: 1}, {kind: "num", val: 2}]}],
# ])
def test_parse_exact_ast(query, expected):
  assert_eq(_parse(query), expected)
end

def test_parse_break_with_value():
  let ast = _parse("break 5")
  | assert_eq({kind: ast[:kind], val_kind: ast[:val][:kind]}, {kind: "break", val_kind: "num"})
end

# @parametrize([
#   ["None ?? 1", "??"],
#   ["\"a\" =~ \"b\"", "=~"],
#   ["2 << 3", "<<"],
# ])
def test_parse_binary_op(query, op):
  assert_eq(_parse(query)[:op], op)
end

def test_parse_numeric_rhs_keeps_precedence_and_postfix():
  let chain = _parse("1 + 2 - 3")
  | let precedence = _parse("1 + 2 * 3")
  | let suppressed = _parse("1 + 2?")
  | let indexed = _parse("1 + 2[0]")
  | assert_eq(chain[:left][:op], "+")
  | assert_eq(precedence[:right][:op], "*")
  | assert_eq(suppressed[:right][:kind], "trysuppress")
  | assert_eq(indexed[:right][:kind], "idx")
end

def test_parse_identifier_rhs_keeps_precedence_and_postfix():
  let chain = _parse("1 + x - y")
  | let precedence = _parse("1 + x * 3")
  | let indexed = _parse("1 + x[0]")
  | let called = _parse("1 + f(2)")
  | let namespaced = _parse("1 + math::add(1, 2)")
  | let suppressed = _parse("1 + x?")
  | assert_eq(chain[:left][:op], "+")
  | assert_eq(precedence[:right][:op], "*")
  | assert_eq(indexed[:right][:kind], "idx")
  | assert_eq(called[:right][:kind], "call")
  | assert_eq(namespaced[:right][:name], "math::add")
  | assert_eq(suppressed[:right][:kind], "trysuppress")
end

def test_parse_try_catch():
  let ast = _parse("try: 1 catch: 2")
  | assert_eq({kind: ast[:kind], body_kind: ast[:body][:kind], catch_kind: ast[:catch_body][:kind], catch_var: ast[:catch_var]},
              {kind: "try", body_kind: "num", catch_kind: "num", catch_var: None})
end

def test_parse_try_catch_with_binder():
  let ast = _parse("try: 1 catch(e): e")
  | assert_eq({kind: ast[:kind], catch_var: ast[:catch_var], catch_kind: ast[:catch_body][:kind]},
              {kind: "try", catch_var: "e", catch_kind: "ident"})
end

# @parametrize([
#   ["until (i < 5): i end", "until"],
#   ["unless (i < 5): i", "unless"],
# ])
def test_parse_conditional_loop_or_branch(query, kind):
  let ast = _parse(query)
  | assert_eq({kind: ast[:kind], cond_op: ast[:cond][:op], body_kind: ast[:body][:kind]},
              {kind: kind, cond_op: "<", body_kind: "ident"})
end

def test_parse_interp():
  let ast = _parse("s\"x${1}y\"")
  | assert_eq(ast[:kind], "interp")
  | assert_eq(len(ast[:segs]), 3)
  | assert_eq(ast[:segs][1][:kind], "expr")
  | assert_eq(ast[:segs][1][:node], {kind: "num", val: 1})
end

def test_parse_error_suppress():
  let ast = _parse("f()?")
  | assert_eq(ast[:kind], "trysuppress")
  | assert_eq(ast[:target], {kind: "call", name: "f", args: []})
end

def test_parse_def_default_param():
  let ast = _parse("def f(x, y=1): x end")
  | assert_eq(ast[:params], [{name: "x", default: None}, {name: "y", default: {kind: "num", val: 1}}])
end

def test_parse_let_array_destructure():
  let ast = _parse("let [a, b] = [1, 2]")
  | assert_eq(ast[:kind], "let_destructure")
  | assert_eq(ast[:pattern], {kind: "arraypat", names: ["a", "b"], rest: None})
end

def test_parse_let_array_destructure_rest():
  let ast = _parse("let [head, ..tail] = [1, 2, 3]")
  | assert_eq(ast[:pattern], {kind: "arraypat", names: ["head"], rest: "tail"})
end

def test_parse_let_dict_destructure():
  let ast = _parse("let {name, age} = obj")
  | assert_eq(ast[:kind], "let_destructure")
  | assert_eq(ast[:pattern], {kind: "dictpat", names: ["name", "age"]})
end

def test_parse_large_array_destructure_with_rest_after_threshold():
  let names = map(range(0, 299), fn(i): "p" + to_string(i) end)
  | let source = "let [" + join(names[0:260], ",") + ",..tail," +
      join(names[260:len(names)], ",") + "] = xs"
  | let pattern = _parse(source)[:pattern]
  | assert_eq(pattern, {kind: "arraypat", names: names, rest: "tail"})
end

def test_parse_large_dict_destructure_with_trailing_comma():
  let names = map(range(0, 299), fn(i): "p" + to_string(i) end)
  | let pattern = _parse("let {" + join(names, ",") + ",} = xs")[:pattern]
  | assert_eq(pattern, {kind: "dictpat", names: names})
end

def test_parse_match_arms():
  let ast = _parse("match (x): | 1: \"one\" | _: \"other\" end")
  | assert_eq(ast[:kind], "match")
  | assert_eq(len(ast[:arms]), 2)
  | assert_eq(ast[:arms][0][:pattern], {kind: "litpat", val: {kind: "num", val: 1}})
  | assert_eq(ast[:arms][1][:pattern], {kind: "wildpat"})
end

def test_parse_match_type_pattern():
  let ast = _parse("match (x): | :string: 1 end")
  | assert_eq(ast[:arms][0][:pattern], {kind: "typepat", name: "string"})
end

def test_parse_match_guard():
  let ast = _parse("match (x): | y if (y > 0): 1 end")
  | let arm = ast[:arms][0]
  | assert_eq(arm[:pattern], {kind: "bindpat", name: "y"})
  | assert_eq(arm[:guard][:kind], "bin")
  | assert_eq(arm[:guard][:op], ">")
end

def test_parse_match_or_pattern():
  let ast = _parse("match (x): | 1 || 2: \"a\" end")
  | assert_eq(ast[:arms][0][:pattern][:kind], "orpat")
end

def test_parse_module():
  let ast = _parse("module math: def add(a, b): a end end")
  | assert_eq(ast[:kind], "module")
  | assert_eq(ast[:name], "math")
end

def test_parse_def_semicolon_terminator():
  let ast = _parse("def f(x): x;")
  | assert_eq(ast[:kind], "def")
  | assert_eq(ast[:body], {kind: "ident", name: "x"})
end

def test_parse_array_simple_and_compound_items():
  let items = _parse("[\"+\", x, 1 + 2, f(3), x[0]]")[:items]
  | assert_eq(items[0], {kind: "str", val: "+"})
  | assert_eq(items[1], {kind: "ident", name: "x"})
  | assert_eq(items[2][:kind], "bin")
  | assert_eq(items[3][:kind], "call")
  | assert_eq(items[4][:kind], "idx")
end

def test_parse_call_simple_and_compound_args():
  let args = _parse("f(1, x, x + 2, g(3))")[:args]
  | assert_eq(args[0], {kind: "num", val: 1})
  | assert_eq(args[1], {kind: "ident", name: "x"})
  | assert_eq(args[2][:kind], "bin")
  | assert_eq(args[3][:kind], "call")
end

def test_parse_dict_simple_and_compound_values():
  let pairs = _parse("{a: 1, b: x + 2}")[:pairs]
  | assert_eq(pairs[0][:val], {kind: "num", val: 1})
  | assert_eq(pairs[1][:val][:kind], "bin")
end

def test_parse_nested_lists():
  let items = _parse("[[1, 2], f(3, [4, 5]), {a: [6, 7], b: 8}]")[:items]
  | assert_eq(len(items), 3)
  | assert_eq(len(items[0][:items]), 2)
  | assert_eq(len(items[1][:args]), 2)
  | assert_eq(len(items[1][:args][1][:items]), 2)
  | assert_eq(len(items[2][:pairs]), 2)
  | assert_eq(len(items[2][:pairs][0][:val][:items]), 2)
end

def test_parse_closers_inside_string_literals():
  let items = _parse("[1, \"]\", [2, 3], {a: 4}]")[:items]
  | assert_eq(len(items), 4)
  | assert_eq(items[1], {kind: "str", val: "]"})
  | assert_eq(items[2][:kind], "arr")
  | let args = _parse("f(1, \")\", [2, 3])")[:args]
  | assert_eq(len(args), 3)
  | assert_eq(args[1], {kind: "str", val: ")"})
  | let pairs = _parse("{a: 1, b: \"}\", c: [2, 3]}")[:pairs]
  | assert_eq(len(pairs), 3)
  | assert_eq(pairs[1][:val], {kind: "str", val: "}"})
  | let index = _parse("[1, 2][\"]\"]")
  | assert_eq(index[:kind], "idx")
  | assert_eq(index[:index], {kind: "str", val: "]"})
  | let slice = _parse("[1, 2][0:\"]\"]")
  | assert_eq(slice[:kind], "slice")
  | assert_eq(slice[:to], {kind: "str", val: "]"})
  | let colon_index = _parse("[1, 2][\":\"]")
  | assert_eq(colon_index[:kind], "idx")
  | assert_eq(colon_index[:index], {kind: "str", val: ":"})
end
