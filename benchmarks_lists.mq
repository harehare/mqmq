# Run with: mq-bench benchmarks_lists.mq --iterations 3 --warmup 1
# Compare the same case across revisions; imports and token generation run on
# every iteration, so the reported times include shared setup.

import "lexer" | import "parser"
| let nums_64 = join(map(range(0, 63), fn(i): to_string(i) end), ",")
| let nums_256 = join(map(range(0, 255), fn(i): to_string(i) end), ",")
| let nums_512 = join(map(range(0, 511), fn(i): to_string(i) end), ",")
| let array_64 = lexer::lex("[" + nums_64 + "]")
| let array_256 = lexer::lex("[" + nums_256 + "]")
| let array_512 = lexer::lex("[" + nums_512 + "]")
| let args_256 = lexer::lex("f(" + nums_256 + ")")
| let dict_source = "{" + join(map(range(0, 255), fn(i): "k" + to_string(i) + ":" + to_string(i) end), ",") + "}"
| let dict_256 = lexer::lex(dict_source)
|
def bench_array_64(): parser::mq_parse(array_64) end
def bench_array_256(): parser::mq_parse(array_256) end
def bench_array_512(): parser::mq_parse(array_512) end
def bench_args_256(): parser::mq_parse(args_256) end
def bench_dict_256(): parser::mq_parse(dict_256) end
