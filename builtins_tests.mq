# mqmq/builtins_tests.mq
# Built-ins delegated to the host (see "built-ins delegated to the host" in
# eval.mq). Each query comes from the function's own documentation, and the
# expected text is what `mq` itself prints for it. Run with
# `mq-test builtins_tests.mq`.

import "lexer"
| import "parser"
| import "eval"
| include "test"

def _run(q, md):
  let toks = lexer::lex(q)
  | let ast = parser::mq_parse(toks)
  | eval::mq_eval(ast, md, {__nodes__: md})[:val]
end

