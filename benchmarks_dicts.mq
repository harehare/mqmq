# Run with: mq-bench benchmarks_dicts.mq --iterations 10 --warmup 2
# The AST is prepared at module load; repeat evaluation to expose the cost
# of building a dictionary from evaluated key/value pairs.

import "eval"
| let pairs = map(range(0, 1023), fn(i):
    {key: {kind: "str", val: "k" + to_string(i)},
     val: {kind: "num", val: i}}
  end)
| let ast = {kind: "dict", pairs: pairs}
| let nested_dict = {kind: "dict", pairs: pairs[0:4]}
| let nested_array = {kind: "arr", items: map(range(0, 255), fn(i): nested_dict end)}
| let inner_array = {kind: "arr", items: [{kind: "num", val: 1}, {kind: "num", val: 2}]}
| let array_of_arrays = {kind: "arr", items: map(range(0, 255), fn(i): inner_array end)}
|

def bench_dict_1024():
  eval::mq_eval(ast, None, {})[:val]
end

def bench_dict_1024_repeated():
  foreach (i, range(0, 9)):
    eval::mq_eval(ast, None, {})[:val]
  end
end

def bench_nested_dicts():
  eval::mq_eval(nested_array, None, {})[:val]
end

def bench_nested_arrays():
  eval::mq_eval(array_of_arrays, None, {})[:val]
end
