# Run with: mq-bench benchmarks_scanning.mq --iterations 3 --warmup 1
# Setup runs on every iteration. Compare the same case across revisions.

import "lexer"
| import "parser"
| let long_query = join(map(range(1, 1024), fn(i): to_string(i) end), " + ")
| let long_tokens = lexer::lex(long_query)
| let long_whitespace = join(map(range(0, 8191), fn(i): " " end), "") + "1"
|

def bench_parse_long_arithmetic():
  parser::mq_parse(long_tokens)
end

def bench_lex_long_whitespace():
  lexer::lex(long_whitespace)
end
