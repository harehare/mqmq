# mqmq/eval.mq
# Tree-walking evaluator for the mq AST, written in mq.
#
# The evaluator uses mq's own built-in functions to perform operations,
# so it is a meta-interpreter layered on top of the real mq runtime.
#
# eval(ast, value, env) → {val: <result>, env: <updated_env>}
#   ast   - AST node produced by parser.mq
#   value - current "self" value flowing through the pipeline
#   env   - dict of variable bindings {name: value, ...}

import "yaml"
## Node kinds whose mq_eval result env is always the env they were given
## (call, arr, dict, and interp discard their children's envs). A value-only
## evaluation of these needs no {val, env} pair, and a sibling evaluated after
## one of them can reuse the original env.
| let _KEEPS_ENV = {
  "ident": true, "call": true, "str": true, "num": true, "bool": true,
  "none": true, "atom": true, "self": true, "dot": true, "nodes": true,
  "sel": true, "fn": true, "arr": true, "dict": true, "interp": true,
}
| let _HEADING_NAMES = {h1: true, h2: true, h3: true, h4: true, h5: true, h6: true}
| let _NON_TEXT_NAMES = {
  h1: true, h2: true, h3: true, h4: true, h5: true, h6: true,
  code: true, list: true, html: true,
}
|

# ── environment helpers ───────────────────────────────────────────────────────

## Bind a name in the environment, returning the new env.
def _env_set(env, name, val):
  set(env, name, val)
end

## Read the control-flow signal ("none" | "break" | "continue") off an eval result.
def _ctrl(r):
  if (is_none(r[:ctrl])): "none" else: r[:ctrl]
end

## Bind an array or dict destructuring pattern (see parser.mq's "arraypat" /
## "dictpat" nodes) against a value, returning the updated env. Batch large
## patterns; constructing the binding list costs more than set() for small ones.
def _bind_pattern(pat, val, env):
  if (pat[:kind] == "arraypat") do
      let names = pat[:names]
      | if (len(names) >= 32) do
          let bindings = map(range(0, len(names) - 1), fn(i):
            [names[i], if (i < len(val)): val[i] else: None]
          end)
          | let with_rest = if (is_none(pat[:rest])): bindings
              else: bindings + [[pat[:rest], if (len(names) < len(val)): val[len(names):len(val)] else: []]]
          | dict(entries(env) + with_rest)
        end
        else do
          var e = env
          | var i = 0
          | while (i < len(names)):
              e = _env_set(e, names[i], if (i < len(val)): val[i] else: None)
              | i += 1
            end
          | if (!is_none(pat[:rest])):
              e = _env_set(e, pat[:rest], if (len(names) < len(val)): val[len(names):len(val)] else: [])
          | e
        end
    end
  else do
      let names = pat[:names]
      | if (len(names) >= 32) do
          let bindings = map(names, fn(name): [name, val[name]] end)
          | dict(entries(env) + bindings)
        end
        else do
          var e = env
          | var i = 0
          | while (i < len(names)):
              e = _env_set(e, names[i], val[names[i]])
              | i += 1
            end
          | e
        end
    end
end

# ── match / pattern matching ────────────────────────────────────────────────

def _match_type(name, val):
  if (name == "string"): is_string(val)
    elif (name == "number"): is_number(val)
    elif (name == "array"):  is_array(val)
    elif (name == "dict"):   is_dict(val)
    elif (name == "bool"):   is_bool(val)
    elif (name == "none"):   is_none(val)
    else: false
end

## Try to match `val` against a single pattern node, returning
## {matched: bool, env: <env with any bindings applied>}.
def _match_pattern(pat, val, env):
  let k = pat[:kind]
  | if (k == "wildpat"):
      {matched: true, env: env}
    elif (k == "bindpat"):
      {matched: true, env: _env_set(env, pat[:name], val)}
    elif (k == "typepat"):
      {matched: _match_type(pat[:name], val), env: env}
    elif (k == "litpat") do
      let lit_val = _ev(pat[:val], val, env)
      | {matched: val == lit_val, env: env}
    end
    elif (k == "orpat") do
      let lr = _match_pattern(pat[:left], val, env)
      | if (lr[:matched]): lr else: _match_pattern(pat[:right], val, env)
    end
    elif (k == "arraypat") do
      if (!is_array(val)) do
          {matched: false, env: env}
        end
      elif (is_none(pat[:rest]) && len(pat[:names]) != len(val)) do
          {matched: false, env: env}
        end
      elif (!is_none(pat[:rest]) && len(val) < len(pat[:names])) do
          {matched: false, env: env}
        end
      else do
          {matched: true, env: _bind_pattern(pat, val, env)}
        end
    end
    elif (k == "dictpat") do
      if (!is_dict(val)): {matched: false, env: env}
      else: {matched: true, env: _bind_pattern(pat, val, env)}
    end
    else:
      {matched: false, env: env}
end

## Walk match arms in order, returning the {val, env} of the first arm whose
## pattern matches `matchval` and (if present) whose guard is truthy.
def _try_match_arms(arms, matchval, value, env):
  var i = 0
  | var result = None
  | let n = len(arms)
  | while (i < n && is_none(result)):
      let arm = arms[i]
      | let pattern = arm[:pattern]
      | if (pattern[:kind] == "litpat") do
          if (matchval == _ev(pattern[:val], matchval, env) &&
              (is_none(arm[:guard]) || _ev(arm[:guard], value, env))):
            result = mq_eval(arm[:body], value, env)
        end
        else do
          let mr = _match_pattern(pattern, matchval, env)
          | if (mr[:matched] && (is_none(arm[:guard]) || _ev(arm[:guard], value, mr[:env]))):
              result = mq_eval(arm[:body], value, mr[:env])
        end
      | i += 1
    end
  | if (is_none(result)): error("No match arm matched") else: result
end

# ── apply a closure (fn node) to arguments ───────────────────────────────────

## Apply a single-arg fn closure to one argument.
def _apply1(fn_val, arg, env):
  let p = if (is_empty(fn_val[:params])): "_" else: fn_val[:params][0][:name]
  | let call_env = set(fn_val[:env], p, arg)
  | _ev(fn_val[:body], arg, call_env)
end

## Left-fold arr with fn(acc, item), starting from init. (No native `reduce`
## builtin exists in real mq, so this is done by hand with a while loop.)
def _reduce(arr, init, fn_val, env):
  if (is_dict(fn_val) && fn_val[:kind] == "fn" && !is_empty(arr)) do
    let params = fn_val[:params]
    | let p1 = if (len(params) > 0): params[0][:name] else: "_"
    | let p2 = if (len(params) > 1): params[1][:name] else: "_"
    | let closure_env = fn_val[:env]
    | let body = fn_val[:body]
    | var acc = init
    | var i = 0
    | let n = len(arr)
    | while (i < n):
        let item = arr[i]
        | acc = _ev(body, acc, set(set(closure_env, p1, acc), p2, item))
        | i += 1
      end
    | acc
  end
  else do
    var acc = init
    | var i = 0
    | let n = len(arr)
    | while (i < n):
        acc = _apply2(fn_val, acc, arr[i], env)
        | i += 1
      end
    | acc
  end
end

## Apply a two-arg fn closure.
def _apply2(fn_val, a1, a2, env):
  let params = fn_val[:params]
  | let p1 = if (len(params) > 0): params[0][:name] else: "_"
  | let p2 = if (len(params) > 1): params[1][:name] else: "_"
  | let call_env = set(set(fn_val[:env], p1, a1), p2, a2)
  | _ev(fn_val[:body], a1, call_env)
end

# ── moku Markdown filters ────────────────────────────────────────────────────

# Make a wikilink from a scalar, or from every item in an array.  This returns
# ordinary Markdown text rather than a parsed node because mq's native runtime
# has a wikilink selector but no corresponding node constructor.
def _moku_wikilink(value):
  if (is_array(value)):
      map(value, fn(item): _moku_wikilink(item) end)
    else:
      "[[" + to_string(value) + "]]"
end

# Serialize a value as one YAML property.  Collections are indented beneath
# the property key; scalar values stay on the same line.  `yaml_stringify` is
# delegated to mq's standard yaml module, rather than reimplemented here.
def _moku_yaml_property(value, key):
  let yaml = yaml::yaml_stringify(value)
  | if (is_array(value) || is_dict(value)):
      key + ":\n" + indent(yaml, "  ")
    else:
      key + ": " + yaml
end

# ── selector evaluation ───────────────────────────────────────────────────────

## Filter a value (array of nodes or a single node) by a named selector.
def _eval_sel(name, value):
  let pred = if (name == "h1"): fn(node): is_h1(node) end
    elif (name == "h2"): fn(node): is_h2(node) end
    elif (name == "h3"): fn(node): is_h3(node) end
    elif (name == "h4"): fn(node): is_h4(node) end
    elif (name == "h5"): fn(node): is_h5(node) end
    elif (name == "h6"): fn(node): is_h6(node) end
    elif (name == "h"): fn(node): !is_none(_HEADING_NAMES[to_md_name(node)]) end
    elif (name == "code"): fn(node): is_code(node) end
    elif (name == "list" || name == "list_item"): fn(node): is_list(node) end
    elif (name == "table_cell"): fn(node): is_table_cell(node) end
    elif (name == "table_align"): fn(node): is_table_align(node) end
    elif (name == "table"): fn(node): is_table_cell(node) || is_table_align(node) end
    elif (name == "blockquote"): fn(node): to_md_name(node) == "blockquote" end
    elif (name == "thematic_break"): fn(node): to_md_name(node) == "Horizontal_rule" end
    elif (name == "html"): fn(node): is_html(node) end
    elif (name == "definition"): fn(node): to_md_name(node) == "definition" end
    elif (name == "text"): fn(node): is_none(_NON_TEXT_NAMES[to_md_name(node)]) end
    else: error("Unknown selector: ." + name)
  | if (is_array(value)):
      filter(value, pred)
    elif (pred(value)):
      [value]
    else:
      []
end

# ── built-in function dispatch ────────────────────────────────────────────────

## Evaluate a built-in function call.
## args_vals is the list of already-evaluated argument values.
def _eval_builtin(name, args_vals, value, env):
  # Helper: first arg or current value if no args
  let a0 = if (len(args_vals) > 0): args_vals[0] else: value
  | let a1 = if (len(args_vals) > 1): args_vals[1] else: None
  | let a2 = if (len(args_vals) > 2): args_vals[2] else: None

  # Type predicates
  | if (name == "is_empty"):    is_empty(a0)
    elif (name == "is_array"):  is_array(a0)
    elif (name == "is_dict"):   is_dict(a0)
    elif (name == "is_string"): is_string(a0)
    elif (name == "is_number"): is_number(a0)
    elif (name == "is_bool"):   is_bool(a0)
    elif (name == "is_none"):   is_none(a0)

    # Markdown node type predicates
    elif (name == "is_h1"):           is_h1(a0)
    elif (name == "is_h2"):           is_h2(a0)
    elif (name == "is_h3"):           is_h3(a0)
    elif (name == "is_h4"):           is_h4(a0)
    elif (name == "is_h5"):           is_h5(a0)
    elif (name == "is_h6"):           is_h6(a0)
    elif (name == "is_h"):            is_h(a0)
    elif (name == "is_code"):         is_code(a0)
    elif (name == "is_list"):         is_list(a0)
    elif (name == "is_list_item"):    is_list(a0)
    elif (name == "is_table_cell"):   is_table_cell(a0)
    elif (name == "is_table_align"):  is_table_align(a0)
    elif (name == "is_table"):        is_table_cell(a0) || is_table_align(a0)
    elif (name == "is_blockquote"):   to_md_name(a0) == "blockquote"
    elif (name == "is_thematic_break"): to_md_name(a0) == "Horizontal_rule"
    elif (name == "is_html"):         is_html(a0)
    elif (name == "is_definition"):   to_md_name(a0) == "definition"

    # Conversion
    elif (name == "to_text"):   to_text(a0)
    elif (name == "to_string"): to_string(a0)
    elif (name == "to_number"): to_number(a0)
    elif (name == "to_bool"):   a0 == true || (is_number(a0) && a0 != 0) || (is_string(a0) && !is_empty(a0))

    # Collection inspection
    elif (name == "len"):     len(a0)
    elif (name == "first"):   first(a0)
    elif (name == "last"):    last(a0)
    elif (name == "keys"):    keys(a0)
    elif (name == "values"):  values(a0)
    elif (name == "entries"): entries(a0)

    # Collection construction / transformation
    elif (name == "range"):
      if (len(args_vals) == 1): range(a0)
      else: range(a0, a1)
    elif (name == "flatten"):  flatten(a0)
    elif (name == "compact"):  compact(a0)
    elif (name == "unique"):   unique_by(a0, fn(x): x end)
    elif (name == "sort"):     sort(a0)
    elif (name == "reverse"):  reverse(a0)
    elif (name == "head") do
      let n = if (is_none(a1)): 1 else: a1
      | a0[0:n]
    end
    elif (name == "tail") do
      let n = if (is_none(a1)): 1 else: a1
      | let ln = len(a0)
      | let from = if (ln - n < 0): 0 else: ln - n
      | a0[from:ln]
    end
    elif (name == "zip"):      zip(a0, a1)

    # Coroutine / lazy stream builtins (no interpreted `yield`, see Known Limitations).
    elif (name == "is_coroutine"): is_coroutine(a0)
    elif (name == "to_coroutine"): to_coroutine(a0)
    elif (name == "collect"):      collect(a0)
    elif (name == "stream_range"):
      if (len(args_vals) == 2): stream_range(a0, a1)
      else: stream_range(a0, a1, a2)
    elif (name == "next"):      next(a0)
    elif (name == "close"):     close(a0)
    elif (name == "iterables"): iterables(a0)
    # 2-arity: `x | take(n)` (self as 1st arg) and `take(x, n)` (both explicit) both work.
    elif (name == "send"):
      if (len(args_vals) == 2): send(a0, a1) else: send(value, a0)
    elif (name == "take"):
      if (len(args_vals) == 2): take(a0, a1) else: take(value, a0)
    elif (name == "skip"):
      if (len(args_vals) == 2): skip(a0, a1) else: skip(value, a0)
    elif (name == "take_while") do
      let arr = if (len(args_vals) == 2): a0 else: value
      | let f = if (len(args_vals) == 2): a1 else: a0
      | take_while(arr, fn(item): _apply1(f, item, env) end)
    end
    elif (name == "skip_while") do
      let arr = if (len(args_vals) == 2): a0 else: value
      | let f = if (len(args_vals) == 2): a1 else: a0
      | skip_while(arr, fn(item): _apply1(f, item, env) end)
    end

    # Higher-order collection functions (a1 must be a fn closure)
    elif (name == "map") do
      if (is_dict(a1) && a1[:kind] == "fn" && !is_empty(a0)) do
        let p = if (is_empty(a1[:params])): "_" else: a1[:params][0][:name]
        | let closure_env = a1[:env]
        | let body = a1[:body]
        | map(a0, fn(item): _ev(body, item, set(closure_env, p, item)) end)
      end
      else:
        map(a0, fn(item): _apply1(a1, item, env) end)
    end
    elif (name == "filter") do
      if (is_dict(a1) && a1[:kind] == "fn" && !is_empty(a0)) do
        let p = if (is_empty(a1[:params])): "_" else: a1[:params][0][:name]
        | let closure_env = a1[:env]
        | let body = a1[:body]
        | filter(a0, fn(item): _ev(body, item, set(closure_env, p, item)) end)
      end
      else:
        filter(a0, fn(item): _apply1(a1, item, env) end)
    end
    elif (name == "flat_map"):
      flat_map(a0, fn(item): _apply1(a1, item, env) end)
    elif (name == "sort_by"):
      sort_by(a0, fn(item): _apply1(a1, item, env) end)
    elif (name == "group_by"):
      group_by(a0, fn(item): _apply1(a1, item, env) end)
    elif (name == "reduce"):
      _reduce(a0, a2, a1, env)
    elif (name == "each"):
      each(a0, fn(item): _apply1(a1, item, env) end)
    elif (name == "any"):
      any(a0, fn(item): _apply1(a1, item, env) end)
    elif (name == "all"):
      all(a0, fn(item): _apply1(a1, item, env) end)

    # Array mutation helpers
    elif (name == "get"):   get(a0, a1)
    elif (name == "set"):   set(a0, a1, a2)
    elif (name == "del"):   del(a0, a1)
    elif (name == "push"):  a0 + [a1]
    elif (name == "pop"):   a0[0:len(a0) - 1]

    # String operations
    elif (name == "contains"):     contains(a0, a1)
    elif (name == "starts_with"):  starts_with(a0, a1)
    elif (name == "ends_with"):    ends_with(a0, a1)
    elif (name == "replace"):      replace(a0, a1, a2)
    elif (name == "gsub"):         gsub(a0, a1, a2)
    elif (name == "split"):        split(a0, a1)
    elif (name == "join"):         join(a0, if (is_none(a1)): "" else: a1)
    elif (name == "trim"):         trim(a0)
    elif (name == "ltrim"):        ltrim(a0)
    elif (name == "rtrim"):        rtrim(a0)
    elif (name == "upper"):        upcase(a0)
    elif (name == "lower"):        downcase(a0)
    elif (name == "regex_match"):  regex_match(a0, a1)

    # Math
    elif (name == "abs"):   abs(a0)
    elif (name == "floor"): floor(a0)
    elif (name == "ceil"):  ceil(a0)
    elif (name == "round"): round(a0)
    elif (name == "min"):
      if (len(args_vals) == 1): first(sort(a0))
      else: min(a0, a1)
    elif (name == "max"):
      if (len(args_vals) == 1): last(sort(a0))
      else: max(a0, a1)
    elif (name == "pow"):   pow(a0, a1)
    elif (name == "sqrt"):  sqrt(a0)
    elif (name == "log"):   ln(a0)

    # Node / markdown operations
    elif (name == "select") do
      let pred_fn = a0
      | filter(if (is_array(value)): value else: [value], fn(node): _apply1(pred_fn, node, env) end)
    end
    elif (name == "attr"):   attr(a0, a1)
    elif (name == "set_attr"): set_attr(a0, a1, a2)
    elif (name == "to_md_text"): to_md_text(a0)
    elif (name == "to_md_list"): to_md_list(a0, a1)
    elif (name == "to_html"): to_html(a0)

    # Markdown construction and moku-compatible formatting filters.  The
    # short names take their value from the pipeline (`title | h1`), while the
    # `to_*` names retain mq's explicit-argument API.
    elif (name == "to_h"):          to_h(a0, a1)
    elif (name == "to_blockquote"): to_blockquote(a0)
    elif (name == "to_strong"):     to_strong(a0)
    elif (name == "to_em"):         to_em(a0)
    elif (name == "to_delete"):     to_delete(a0)
    elif (name == "to_code"):       to_code(a0, a1)
    elif (name == "to_code_inline"): to_code_inline(a0)
    elif (name == "h1"): to_h(a0, 1)
    elif (name == "h2"): to_h(a0, 2)
    elif (name == "h3"): to_h(a0, 3)
    elif (name == "h4"): to_h(a0, 4)
    elif (name == "h5"): to_h(a0, 5)
    elif (name == "h6"): to_h(a0, 6)
    elif (name == "blockquote"): to_blockquote(a0)
    elif (name == "bold"):       to_strong(a0)
    elif (name == "italic"):     to_em(a0)
    elif (name == "strike"):     to_delete(a0)
    elif (name == "code_inline"): to_code_inline(a0)
    elif (name == "code"):        to_code(value, a0)
    elif (name == "wikilink"):    _moku_wikilink(a0)
    elif (name == "yaml_property"): _moku_yaml_property(value, a0)

    # Control
    elif (name == "error"): error(a0)
    elif (name == "debug"): debug(a0)
    elif (name == "env"):   env

    else do
      # Try to look up as user-defined function in env
      let fn_val = env[name]
      | if (is_none(fn_val)):
          error("Unknown function: " + name)
        else:
          _call_user_fn(fn_val, args_vals, value, env)
    end
end

## Call a user-defined function (def or fn closure) with a list of arg values.
## Params are {name, default} pairs; a missing trailing arg falls back to its
## default expression (evaluated in the call env built up so far, so later
## defaults may reference earlier params) or None if there is no default.
def _call_user_fn(fn_val, args_vals, value, env):
  let params = fn_val[:params]
  | let count = len(params)
  | if (count >= 8 && len(args_vals) >= count) do
      # All parameters are supplied, so defaults cannot inspect earlier
      # bindings. Build the call environment once instead of copying it for
      # every parameter.
      let self_entry = if (is_none(fn_val[:name])): [] else: [[fn_val[:name], fn_val]]
      | let bindings = foreach (i, range(0, count - 1)):
          [params[i][:name], args_vals[i]]
        end
      | _ev(fn_val[:body], value, dict(entries(fn_val[:env]) + self_entry + bindings))
    end
    else do
      var call_env = fn_val[:env]
      | if (!is_none(fn_val[:name])):
          call_env = _env_set(call_env, fn_val[:name], fn_val)
      | var i = 0
      | while (i < count):
          let p = params[i]
          | let arg_val = if (i < len(args_vals)): args_vals[i]
                          elif (!is_none(p[:default])): _ev(p[:default], value, call_env)
                          else: None
          | call_env = set(call_env, p[:name], arg_val)
          | i += 1
        end
      | _ev(fn_val[:body], value, call_env)
    end
end

# ── conversion operator (@) ─────────────────────────────────────────────────

## real mq's atoms (`:h1`, `:base64`, ...) are a distinct Symbol runtime type
## that the host `@` operator switches on; mqmq's own atom nodes evaluate to
## plain strings instead, so `@` can't just delegate to the host operator for
## symbol-style targets. Reimplemented from scratch using mq's own string /
## hashing / encoding builtins so both `x @ :h1` and `x @ "#"` style targets
## (mqmq atoms and real mq's plain-string targets alike) work the same way.
def _is_url_or_path(s):
  !is_empty(regex_match(s, "^(https?://|\\./|\\.\\./|/)"))
end

def _eval_convert(input, target):
  let s = to_string(input)
  | if (target == "h1" || target == "#"):           "# " + s
    elif (target == "h2" || target == "##"):        "## " + s
    elif (target == "h3" || target == "###"):       "### " + s
    elif (target == "h4" || target == "####"):      "#### " + s
    elif (target == "h5" || target == "#####"):     "##### " + s
    elif (target == "h6" || target == "######"):    "###### " + s
    elif (target == ">"):        "> " + s
    elif (target == "-"):        "- " + s
    elif (target == "~~"):       "~~" + s + "~~"
    elif (target == "**"):       "**" + s + "**"
    elif (target == "--"):       "---"
    elif (target == "base64"):   base64(s)
    elif (target == "md5"):      md5(s)
    elif (target == "sha256"):   sha256(s)
    elif (target == "uri"):      url_encode(s)
    elif (target == "urid"):     url_decode(s)
    elif (target == "html"):     to_html(input)
    elif (target == "text"):     to_text(input)
    elif (_is_url_or_path(target)): "[" + s + "](" + target + ")"
    else: error("Invalid convert: " + to_string(target))
end

# ── binary operator evaluation ────────────────────────────────────────────────

def _eval_bin(op, left_val, right_val):
  if (op == "+"):  left_val + right_val
    elif (op == "-"):  left_val - right_val
    elif (op == "*"):  left_val * right_val
    elif (op == "/"):  left_val / right_val
    elif (op == "%"):  left_val % right_val
    elif (op == "=="):  left_val == right_val
    elif (op == "!="):  left_val != right_val
    elif (op == "<"):   left_val < right_val
    elif (op == "<="):  left_val <= right_val
    elif (op == ">"):   left_val > right_val
    elif (op == ">="):  left_val >= right_val
    elif (op == "&&"):  left_val && right_val
    elif (op == "||"):  left_val || right_val
    elif (op == "??"):  if (is_none(left_val)): right_val else: left_val
    elif (op == "<<"):  left_val << right_val
    elif (op == ">>"):  left_val >> right_val
    elif (op == "=~"):  is_regex_match(left_val, right_val)
    elif (op == "!~"):  is_not_regex_match(left_val, right_val)
    elif (op == ".."):  left_val..right_val
    elif (op == "@"):   _eval_convert(left_val, right_val)
    else: error("Unknown binary operator: " + op)
end

# ── value-only evaluation ─────────────────────────────────────────────────────

## Evaluate an AST node for its value alone. Most nodes are leaves, calls, or
## operators, and returning their value directly avoids allocating a
## {val, env} pair per node. Kinds that can change the env or carry a
## break/continue signal fall back to mq_eval; callers of _ev discard both.
def _ev(ast, value, env):
  let k = ast[:kind]
  | if (k == "ident") do
      let v = env[ast[:name]]
      | if (is_none(v)): _eval_builtin(ast[:name], [], value, env) else: v
    end
    elif (k == "num" || k == "str" || k == "bool"): ast[:val]
    elif (k == "call"): _ev_call(ast, value, env)
    elif (k == "bin"): _ev_bin(ast, value, env)
    elif (k == "if"): _ev_if(ast, value, env)
    elif (k == "self" || k == "dot"): value
    elif (k == "none"): None
    elif (k == "un") do
      let v = _ev(ast[:expr], value, env)
      | if (ast[:op] == "!"): !v
        elif (ast[:op] == "-"): 0 - v
        else: v
    end
    elif (k == "dkey"): _ev(ast[:base], value, env)[ast[:key]]
    else: mq_eval(ast, value, env)[:val]
end

def _ev_call(ast, value, env):
  let args = ast[:args]
  | let n = len(args)
  | let named = env[ast[:name]]
  # A supplied single argument needs neither an argument array nor the
  # general parameter/default binding loop. Keep the recursive name binding
  # before the parameter binding so a parameter can shadow its own function.
  | if (n == 1 && is_dict(named) && named[:kind] == "fn" && len(named[:params]) == 1) do
      let arg_val = _ev(args[0], value, env)
      | let fn_name = named[:name]
      | let base_env = if (is_none(fn_name)): named[:env]
                       else: set(named[:env], fn_name, named)
      | _ev(named[:body], value, set(base_env, named[:params][0][:name], arg_val))
    end
    else do
      let args_vals = if (n == 0): []
                        elif (n == 1): [_ev(args[0], value, env)]
                        else: map(args, fn(a): _ev(a, value, env) end)
      | if (is_dict(named) && named[:kind] == "fn"):
          _call_user_fn(named, args_vals, value, env)
        else:
          _eval_builtin(ast[:name], args_vals, value, env)
    end
end

## The right operand still sees any bindings the left operand made, as in
## mq_eval's "bin" case.
def _ev_bin(ast, value, env):
  let left = ast[:left]
  | let op = ast[:op]
  | if (_KEEPS_ENV[left[:kind]]) do
      let lv = _ev(left, value, env)
      # Common arithmetic/comparison operators can use the host operation
      # directly; the remaining operators retain the shared dispatch below.
      | if (op == "+"): lv + _ev(ast[:right], value, env)
        elif (op == "-"): lv - _ev(ast[:right], value, env)
        elif (op == "<"): lv < _ev(ast[:right], value, env)
        elif (op == "&&" && !lv): false
        elif (op == "||" && lv): lv
        elif (op == "??" && !is_none(lv)): lv
        else: _eval_bin(op, lv, _ev(ast[:right], value, env))
    end
    else do
      let lr = mq_eval(left, value, env)
      | let lv = lr[:val]
      | if (op == "&&" && !lv): false
        elif (op == "||" && lv): lv
        elif (op == "??" && !is_none(lv)): lv
        else: _eval_bin(op, lv, _ev(ast[:right], value, lr[:env]))
    end
end

def _ev_if(ast, value, env):
  if (_ev(ast[:cond], value, env)): _ev(ast[:then], value, env)
  else do
    let elifs = ast[:elifs]
    | let n = len(elifs)
    | var i = 0
    | var branch = ast[:else_br]
    | while (i < n):
        let e = elifs[i]
        | if (_ev(e[:cond], value, env)) do
            branch = e[:body]
            | i = n
          end
          else: i += 1
      end
    | if (is_none(branch)): None else: _ev(branch, value, env)
  end
end

## Like mq_eval, but without its {val, env} result for a node that keeps its
## env, so a binding's value costs one pair instead of two.
def _eval_keep_env(ast, value, env):
  if (_KEEPS_ENV[ast[:kind]]): {val: _ev(ast, value, env), env: env}
  else: mq_eval(ast, value, env)
end

## General "bin" case: bindings made by the left operand are visible to the
## right operand and in the result env.
def _eval_bin_node(ast, value, env):
  let lr = _eval_keep_env(ast[:left], value, env)
  | let op = ast[:op]
  | if (op == "&&" && !lr[:val]):
      {val: false, env: lr[:env]}
    elif (op == "||" && lr[:val]):
      {val: lr[:val], env: lr[:env]}
    elif (op == "??" && !is_none(lr[:val])):
      {val: lr[:val], env: lr[:env]}
    elif (_KEEPS_ENV[ast[:right][:kind]]):
      {val: _eval_bin(op, lr[:val], _ev(ast[:right], value, lr[:env])), env: lr[:env]}
    else do
      let rr = mq_eval(ast[:right], value, lr[:env])
      | {val: _eval_bin(op, lr[:val], rr[:val]), env: rr[:env]}
    end
end

## Evaluate a left-associated binary chain without recursively evaluating
## each intermediate bin node. Each stack link is a two-item array; right
## operands still see earlier bindings.
def _eval_bin_chain(ast, value, env):
  var stages = None
  | var cursor = ast
  | while (cursor[:kind] == "bin"):
      stages = [cursor, stages]
      | cursor = cursor[:left]
    end
  | let first = _eval_keep_env(cursor, value, env)
  | var acc = first[:val]
  | var cur_env = first[:env]
  | while (!is_none(stages)):
      let stage = stages[0]
      | let op = stage[:op]
      # A short-circuit leaves acc and cur_env unchanged.
      | if (op == "&&" && !acc): acc = false
        elif (op == "||" && acc): None
        elif (op == "??" && !is_none(acc)): None
        else do
          let right = stage[:right]
          | if (_KEEPS_ENV[right[:kind]]):
              acc = _eval_bin(op, acc, _ev(right, value, cur_env))
            else do
              let rr = mq_eval(right, value, cur_env)
              | acc = _eval_bin(op, acc, rr[:val])
              | cur_env = rr[:env]
            end
        end
      | stages = stages[1]
    end
  | {val: acc, env: cur_env}
end

# ── main evaluator ────────────────────────────────────────────────────────────

## Evaluate an AST node, returning {val: <result>, env: <env>}.
def mq_eval(ast, value, env):
  let k = ast[:kind]
  | if (k == "ident") do
      let v = env[ast[:name]]
      | if (is_none(v)):
          {val: _eval_builtin(ast[:name], [], value, env), env: env}
        else:
          {val: v, env: env}
    end
    elif (k == "call"): {val: _ev_call(ast, value, env), env: env}
    elif (k == "bin"):
      if (ast[:left][:kind] == "bin" && ast[:left][:left][:kind] == "bin"):
        _eval_bin_chain(ast, value, env)
      elif (_KEEPS_ENV[ast[:left][:kind]] && _KEEPS_ENV[ast[:right][:kind]]):
        {val: _ev_bin(ast, value, env), env: env}
      else:
        _eval_bin_node(ast, value, env)
    elif (k == "pipe") do
      if (ast[:left][:kind] != "pipe") do
        let lr = mq_eval(ast[:left], value, env)
        | if (_ctrl(lr) != "none"): lr
          else: mq_eval(ast[:right], lr[:val], lr[:env])
      end
      else do
        var stages = None
        | var cursor = ast
        # Two-item array links are cheaper than tiny dictionaries here.
        | while (cursor[:kind] == "pipe"):
            stages = [cursor[:right], stages]
            | cursor = cursor[:left]
          end
        | let first = mq_eval(cursor, value, env)
        | var result_val = first[:val]
        | var result_env = first[:env]
        | var signal = _ctrl(first)
        | while (!is_none(stages) && signal == "none"):
            let stage = stages[0]
            | if (_KEEPS_ENV[stage[:kind]]):
                result_val = _ev(stage, result_val, result_env)
              else do
                let result = mq_eval(stage, result_val, result_env)
                | result_val = result[:val]
                | result_env = result[:env]
                | signal = _ctrl(result)
              end
            | stages = stages[1]
          end
        | if (signal == "none"): {val: result_val, env: result_env}
          else: {val: result_val, env: result_env, ctrl: signal}
      end
    end
    elif (k == "str"):   {val: ast[:val], env: env}
    elif (k == "num"):  {val: ast[:val], env: env}
    elif (k == "bool"): {val: ast[:val], env: env}
    elif (k == "none"): {val: None, env: env}
    elif (k == "atom"): {val: ast[:name], env: env}
    elif (k == "self"): {val: value, env: env}
    elif (k == "dot"):  {val: value, env: env}
    elif (k == "nodes"): {val: env["__nodes__"], env: env}
    elif (k == "sel"):   {val: _eval_sel(ast[:name], value), env: env}
    elif (k == "if"):    _eval_if_node(ast, value, env)
    elif (k == "unless"): _eval_unless(ast, value, env)
    elif (k == "do"):    mq_eval(ast[:body], value, env)
    elif (k == "fn"):    {val: {kind: "fn", params: ast[:params], body: ast[:body], env: env}, env: env}
    elif (k == "while"):   _eval_while(ast, value, env)
    elif (k == "until"):   _eval_until(ast, value, env)
    elif (k == "foreach"): _eval_foreach(ast, value, env)

    elif (k == "break") do
      if (is_none(ast[:val])):
        {val: value, env: env, ctrl: "break"}
      else do
        let vr = mq_eval(ast[:val], value, env)
        | {val: vr[:val], env: vr[:env], ctrl: "break"}
      end
    end

    elif (k == "continue"):
      {val: value, env: env, ctrl: "continue"}

    elif (k == "interp") do
      let parts = map(ast[:segs], fn(s):
        if (s[:kind] == "text"): s[:val]
        else: to_string(_ev(s[:node], value, env))
      end)
      | {val: join(parts, ""), env: env}
    end

    elif (k == "try") do
      try:
        mq_eval(ast[:body], value, env)
      catch(e):
        if (is_none(ast[:catch_var])):
          mq_eval(ast[:catch_body], value, env)
        else:
          mq_eval(ast[:catch_body], value, _env_set(env, ast[:catch_var], e))
    end

    elif (k == "trysuppress") do
      try:
        mq_eval(ast[:target], value, env)
      catch:
        {val: None, env: env}
    end

    elif (k == "match") do
      let vr = mq_eval(ast[:val], value, env)
      | _try_match_arms(ast[:arms], vr[:val], value, vr[:env])
    end

    elif (k == "module") do
      # set() preserves key order and updates an existing key in place, only
      # ever appending a genuinely new one at the end (verified against the
      # host runtime). So the module body's new bindings are exactly the
      # tail of its resulting env past the outer env's original key count --
      # no need to check `has(env, nk)` per key of the inner env, which costs
      # O(env size) per lookup on this host's dict and made evaluating a
      # module quadratic in the size of an already-large environment.
      let orig_len = len(keys(env))
      | let inner = mq_eval(ast[:body], value, env)
      | let after_keys = keys(inner[:env])
      | let new_keys = after_keys[orig_len:len(after_keys)]
      | var new_env = env
      | var i = 0
      | while (i < len(new_keys)):
          new_env = _env_set(new_env, ast[:name] + "::" + new_keys[i], inner[:env][new_keys[i]])
          | i += 1
        end
      | {val: None, env: new_env}
    end

    elif (k == "let" || k == "var") do
      let vr = _eval_keep_env(ast[:val], value, env)
      | {val: vr[:val], env: _env_set(vr[:env], ast[:name], vr[:val])}
    end

    elif (k == "let_destructure" || k == "var_destructure") do
      let vr = mq_eval(ast[:val], value, env)
      | let new_env = _bind_pattern(ast[:pattern], vr[:val], vr[:env])
      | {val: vr[:val], env: new_env}
    end

    elif (k == "assign") do
      let vr = _eval_keep_env(ast[:val], value, env)
      | let op = ast[:op]
      | let cur_val = if (is_none(env[ast[:name]])): None else: env[ast[:name]]
      | let new_val = if (op == "="):   vr[:val]
                      elif (op == "+="): cur_val + vr[:val]
                      elif (op == "-="): cur_val - vr[:val]
                      elif (op == "*="): cur_val * vr[:val]
                      elif (op == "/="): cur_val / vr[:val]
                      elif (op == "%="): cur_val % vr[:val]
                      elif (op == "//="): floor(cur_val / vr[:val])
                      else: vr[:val]
      | let new_env = _env_set(vr[:env], ast[:name], new_val)
      | {val: new_val, env: new_env}
    end

    elif (k == "def") do
      let fn_val = {kind: "fn", name: ast[:name], params: ast[:params], body: ast[:body], env: env}
      | let new_env = _env_set(env, ast[:name], fn_val)
      | {val: fn_val, env: new_env}
    end

    elif (k == "un") do
      let er = mq_eval(ast[:expr], value, env)
      | let v = if (ast[:op] == "!"): !er[:val]
                elif (ast[:op] == "-"): 0 - er[:val]
                else: er[:val]
      | {val: v, env: er[:env]}
    end

    elif (k == "arr") do
      let items = map(ast[:items], fn(a): _ev(a, value, env) end)
      | {val: items, env: env}
    end

    elif (k == "dict") do
      # Literal keys are strings. The host constructor inserts entries in
      # order and replaces duplicate keys without copying the growing dict.
      let entries = map(ast[:pairs], fn(pair):
        [_ev(pair[:key], value, env), _ev(pair[:val], value, env)]
      end)
      | {val: dict(entries), env: env}
    end

    elif (k == "idx") do
      let br = mq_eval(ast[:base], value, env)
      | let ir = mq_eval(ast[:index], value, br[:env])
      | {val: br[:val][ir[:val]], env: ir[:env]}
    end

    elif (k == "dkey") do
      let br = mq_eval(ast[:base], value, env)
      | {val: br[:val][ast[:key]], env: br[:env]}
    end

    elif (k == "slice") do
      let br = mq_eval(ast[:base], value, env)
      | let fr = mq_eval(ast[:from], value, br[:env])
      | let tr = if (is_none(ast[:to])): {val: len(br[:val]), env: fr[:env]}
                 else: mq_eval(ast[:to], value, fr[:env])
      | {val: br[:val][fr[:val]:tr[:val]], env: tr[:env]}
    end

    else:
      error("Unknown AST kind: " + to_string(k))
end

# ── if / elif / else ──────────────────────────────────────────────────────────

def _eval_if_node(ast, value, env):
  let cond_val = _ev(ast[:cond], value, env)
  | if (cond_val):
      mq_eval(ast[:then], value, env)
    else:
      _eval_elifs(ast[:elifs], ast[:else_br], value, env)
end

## unless (cond): body -- runs body only when cond is false, else yields None.
def _eval_unless(ast, value, env):
  let cond_val = _ev(ast[:cond], value, env)
  | if (!cond_val):
      mq_eval(ast[:body], value, env)
    else:
      {val: None, env: env}
end

def _eval_elifs(elifs, else_node, value, env):
  var i = 0
  | var result = None
  | let n = len(elifs)
  | while (i < n && is_none(result)):
      let e = elifs[i]
      | if (_ev(e[:cond], value, env)):
          result = mq_eval(e[:body], value, env)
      | i += 1
    end
  | if (!is_none(result)): result
    elif (!is_none(else_node)): mq_eval(else_node, value, env)
    else: {val: None, env: env}
end

# ── while loop ────────────────────────────────────────────────────────────────

def _eval_while(ast, value, env):
  var cur_env = env
  | var cur_val = value
  | var cond = _ev(ast[:cond], cur_val, cur_env)
  | while (cond):
      let br = mq_eval(ast[:body], cur_val, cur_env)
      | let c = _ctrl(br)
      | cur_env = br[:env]
      | if (c == "break") do
          cur_val = br[:val]
          | cond = false
        end
        elif (c == "continue") do
          cond = _ev(ast[:cond], cur_val, cur_env)
        end
        else do
          cur_val = br[:val]
          | cond = _ev(ast[:cond], cur_val, cur_env)
        end
    end
  | {val: cur_val, env: cur_env}
end

# ── until loop ────────────────────────────────────────────────────────────────

## until (cond): body end -- loops while cond is false (inverted `while`).
def _eval_until(ast, value, env):
  var cur_env = env
  | var cur_val = value
  | var cond = !_ev(ast[:cond], cur_val, cur_env)
  | while (cond):
      let br = mq_eval(ast[:body], cur_val, cur_env)
      | let c = _ctrl(br)
      | cur_env = br[:env]
      | if (c == "break") do
          cur_val = br[:val]
          | cond = false
        end
        elif (c == "continue") do
          cond = !_ev(ast[:cond], cur_val, cur_env)
        end
        else do
          cur_val = br[:val]
          | cond = !_ev(ast[:cond], cur_val, cur_env)
        end
    end
  | {val: cur_val, env: cur_env}
end

# ── foreach loop ──────────────────────────────────────────────────────────────

## Uses the host's own `foreach` (rather than a manual `var results = [] |
## while(...): results += [...] end` loop) so the accumulator gets the VM's
## dedicated collect-in-place fast path instead of a fresh array copy on every
## iteration -- the difference is O(n) vs. O(n²) for large inputs. `break`
## inside the host foreach genuinely stops iterating (not just a cheap
## per-item skip), so it also short-circuits the interpreted loop for free.
def _eval_foreach(ast, value, env):
  let iter_val = _ev(ast[:iter], value, env)
  | let iter_var = ast[:iter_var]
  | let body = ast[:body]
  | if (_KEEPS_ENV[body[:kind]]): _eval_foreach_values(iter_var, iter_val, body, env)
    else: _eval_foreach_env(iter_var, iter_val, body, env)
end

## A body that keeps its env can't bind anything or signal break/continue, so
## each item's result is collected directly. The loop variable stays bound to
## the last item afterwards, as in _eval_foreach_env.
def _eval_foreach_values(iter_var, iter_val, body, env):
  var cur_env = env
  | let results = foreach (item, iter_val):
      cur_env = set(env, iter_var, item)
      | _ev(body, item, cur_env)
    end
  | {val: results, env: cur_env}
end

def _eval_foreach_env(iter_var, iter_val, body, env):
  var cur_env = env
  | var broke = false
  | var brk_val = None
  | let results = foreach (item, iter_val):
      let loop_env = set(cur_env, iter_var, item)
      | let br = mq_eval(body, item, loop_env)
      | let signal = br[:ctrl]
      | cur_env = br[:env]
      | if (is_none(signal) || signal == "none"):
          br[:val]
        elif (signal == "break") do
          brk_val = br[:val]
          | broke = true
          | break
        end
        elif (signal == "continue"):
          continue
        else:
          br[:val]
    end
  | if (broke): {val: brk_val, env: cur_env}
    else: {val: results, env: cur_env}
end

## Top-level eval: returns just the value (not the {val,env} pair).
def mq_eval_v(ast, value, env):
  _ev(ast, value, env)
end
