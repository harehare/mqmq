  "get_path": 2, "glob_match": 2, "gt": 2, "gte": 2, "has": 2, "hypot": 2, "indent": 2, "index": 2,
  "index_by": 2, "indices": 2, "insert": 3, "interleave": 2, "interpose": 2, "intersection": 2,
  "is_h_level": 2, "is_not_regex_match": 2, "is_regex_match": 2, "lcm": 2, "lpad": 2, "lt": 2,
  "lte": 2, "ltrimstr": 2, "map_values": 2, "map_while": 2, "markdown_escape": 2, "max_by": 2,
  "merge_defaults": 2, "merge_with": 3, "min_by": 2, "mod": 2, "mul": 2, "ne": 2, "ngram": 2,
  "normalize_newlines": 2, "omit": 2, "or": 2, "pack": 2, "partition": 2, "path_join": 2,
  "percentile": 2, "pick": 2, "pluck": 2, "rand_int": 2, "random_string": 2, "redact": 2,
  "regex_replace": 3, "reject": 2, "remove_chars": 2, "repeat": 2, "replace_prose": 3, "rindex": 2,
  "rpad": 2, "rsplit_once": 2, "rtrimstr": 2, "sample": 2, "scan": 2, "set_check": 2,
  "set_children": 2, "set_code_block_lang": 2, "set_list_ordered": 2, "set_path": 3, "set_ref": 2,
  "shift_left": 2, "shift_right": 2, "slice": 3, "split_once": 2, "split_records": 2,
  "stats_by": 3, "strftime": 2, "strptime": 2, "sub": 2, "sum_by": 2, "tap": 2, "to_callout": 3,
  "to_date": 2, "to_definition": 3, "to_footnote": 2, "to_image": 3, "to_link": 3,
  "to_md_table_cell": 3, "to_number_or": 2, "token_compress": 2, "top_by": 3, "translate": 3,
  "truncate": 3, "unicode_normalize": 2, "union": 2, "unique_by": 2, "unpack": 2, "update": 2,
  "update_path": 3, "walk": 2, "with_entries": 2, "word_wrap": 2, "xor": 2, "zfill": 2
}
|

# The built-in for `name`; a name that is not a built-in resolves to an
# implementation that reports it as unknown.
def _builtin_impl(name):
  let impl = _BUILTINS[name]
  | let ext_impl = if (impl == None): _EXT_BUILTINS[name] else: None
  | if (impl != None): impl
    elif (ext_impl != None): ext_impl
    else: fn(a0, a1, a2, n, value, env): error("Unknown function: " + name) end
end

# Evaluate a built-in function call.
# args_vals is the list of already-evaluated argument values.
def _eval_builtin(name, args_vals, value, env):
  let n = len(args_vals)
  | let impl = _builtin_impl(name)
  | impl(if (n > 0): args_vals[0] else: value,
      if (n > 1): args_vals[1] else: None,
      if (n > 2): args_vals[2] else: None,
      n, value, env)
end

# Call a user-defined function (def or fn closure) with a list of arg values.
# Params are {name, default} pairs; a missing trailing arg falls back to its
# default expression (evaluated in the call env built up so far, so later
# defaults may reference earlier params) or None if there is no default.
# Number of parameters without a default, counted once when the function is
# compiled. A call with exactly one argument fewer gets the piped value as its
# first argument, as in `10 | f()` for `def f(x): ...`.
def _required_params(params):
  len(filter(params, fn(p): p[:default] == None end))
end

def _call_user_fn(fn_val, supplied_args, value, env):
  let params = fn_val[:params]
  | let count = len(params)
  | let args_vals = if (len(supplied_args) < count && fn_val[:req] == len(supplied_args) + 1): [value] + supplied_args
    else: supplied_args
  | let arg_count = len(args_vals)
  | if (arg_count > count || (fn_val[:req] != None && arg_count < fn_val[:req])):
      error("Invalid number of arguments in \"" + (if (fn_val[:name] == None): "" else: fn_val[:name]) +
        "\", expected " + to_string(count) + ", got " + to_string(arg_count))
  | if (count >= 8 && (arg_count >= count || (arg_count >= 64 && len(fn_val[:env]) >= 128))) do
        # Supplied arguments form a prefix, so bind them in one pass. Missing
        # arguments still use sequential set() calls: each default expression
        # can read the bindings made by earlier defaults.
        let supplied = if (arg_count < count): arg_count else: count
        | let self_entry = if (fn_val[:name] == None): [] else: [[fn_val[:name], fn_val]]
        | let bindings = foreach (i, range(0, supplied - 1)):
            [params[i][:name], args_vals[i]]
          end
        | var call_env = dict(entries(fn_val[:env]) + self_entry + bindings)
        | var i = supplied
        | while (i < count):
            let p = params[i]
            | let arg_val = if (p[:default] != None): _call_default(fn_val, i, value, call_env)
              else: None
            | call_env = set(call_env, p[:name], arg_val)
            | i += 1
          end
        | _call_body(fn_val, value, call_env)
      end
    else do
        var call_env = fn_val[:env]
        | if (fn_val[:name] != None):
            call_env = _env_set(call_env, fn_val[:name], fn_val)
        | var i = 0
        | while (i < count):
            let p = params[i]
            | let arg_val = if (i < arg_count): args_vals[i]
              elif (p[:default] != None): _call_default(fn_val, i, value, call_env)
              else: None
            | call_env = set(call_env, p[:name], arg_val)
            | i += 1
          end
        | _call_body(fn_val, value, call_env)
      end
end

# ── conversion operator (@) ─────────────────────────────────────────────────

# real mq's atoms (`:h1`, `:base64`, ...) are a distinct Symbol runtime type
# that the host `@` operator switches on; mqmq's own atom nodes evaluate to
# plain strings instead, so `@` can't just delegate to the host operator for
# symbol-style targets. Reimplemented from scratch using mq's own string /
# hashing / encoding builtins so both `x @ :h1` and `x @ "#"` style targets
# (mqmq atoms and real mq's plain-string targets alike) work the same way.
def _is_url_or_path(s):
  !is_empty(regex_match(s, "^(https?://|\\./|\\.\\./|/)"))
end

def _eval_convert(input, target):
  let s = to_string(input)
  | if (target == "h1" || target == "#"): "# " + s
    elif (target == "h2" || target == "##"): "## " + s
    elif (target == "h3" || target == "###"): "### " + s
    elif (target == "h4" || target == "####"): "#### " + s
    elif (target == "h5" || target == "#####"): "##### " + s
    elif (target == "h6" || target == "######"): "###### " + s
    elif (target == ">"): "> " + s
    elif (target == "-"): "- " + s
    elif (target == "~~"): "~~" + s + "~~"
    elif (target == "**"): "**" + s + "**"
    elif (target == "--"): "---"
    elif (target == "base64"): base64(s)
    elif (target == "md5"): md5(s)
    elif (target == "sha256"): sha256(s)
    elif (target == "uri"): url_encode(s)
    elif (target == "urid"): url_decode(s)
    elif (target == "html"): to_html(input)
    elif (target == "text"): to_text(input)
    elif (_is_url_or_path(target)): "[" + s + "](" + target + ")"
    else: error("Invalid convert: " + to_string(target))
end

# ── binary operator evaluation ────────────────────────────────────────────────

def _eval_bin(op, left_val, right_val):
  if (op == "+"): left_val + right_val
  elif (op == "-"): left_val - right_val
  elif (op == "*"): left_val * right_val
  elif (op == "/"): left_val / right_val
  elif (op == "%"): left_val % right_val
  elif (op == "=="): left_val == right_val
  elif (op == "!="): left_val != right_val
  elif (op == "<"): left_val < right_val
  elif (op == "<="): left_val <= right_val
  elif (op == ">"): left_val > right_val
  elif (op == ">="): left_val >= right_val
  elif (op == "&&"): left_val && right_val
  elif (op == "||"): left_val || right_val
  elif (op == "??"): if (left_val == None): right_val else: left_val
  elif (op == "<<"): left_val << right_val
  elif (op == ">>"): left_val >> right_val
  elif (op == "=~"): is_regex_match(left_val, right_val)
  elif (op == "!~"): is_not_regex_match(left_val, right_val)
  elif (op == ".."): left_val..right_val
  elif (op == "@"): _eval_convert(left_val, right_val)
  else: error("Unknown binary operator: " + op)
end

# ── compilation to closures ───────────────────────────────────────────────────
#
# Evaluating an AST by walking it pays, at every node and every evaluation, for
# a dispatch on the node kind, several dict field reads, and a {val, env}
# result. Instead, the AST is compiled once into closures: dispatch and field
# reads happen at compile time, and a compiled node is a single call.
#
# _comp(ast) returns a [pure, code] pair. A pure node never changes the
# environment and never raises a break/continue signal, so its code is
# `fn(value, env)` returning the value alone. Any other node's code returns
# mq_eval's {val, env[, ctrl]} result. Purity is derived bottom-up, so
# `n - 1`, an `if` over pure branches, or a pipe of pure stages all take the
# value-only path.

# Value-only code for a compiled node (drops a non-pure node's env and signal).
def _as_v(c):
  if (c[0]): c[1]
  else do
      let run = c[1]
      | fn(value, env): run(value, env)[:val] end
    end
end

# The signal a break or continue leaves when no loop catches it.
def _stray_signal(r):
  let c = _ctrl(r)
  | if (c == "continue"): error("continue outside a loop")
    else: error("break outside a loop")
end

# Value-only code for a function body or parameter default. A break or continue
# that escapes it has no loop to end, so it is an error as in mq.
def _as_body(c):
  if (c[0]): c[1]
  else do
      let run = c[1]
      | fn(value, env):
          let r = run(value, env)
          | if (_ctrl(r) == "none"): r[:val] else: _stray_signal(r)
        end
    end
end

# {val, env} code for a compiled node.
def _as_x(c):
  if (c[0]) do
      let run = c[1]
      | fn(value, env): {val: run(value, env), env: env} end
    end
  else: c[1]
end

def _comp_const(v):
  [true, fn(value, env): v end]
end

# A built-in used as a value, e.g. `map(xs, len)` or `let f = to_string`: a
# function value of up to three parameters that hands them to the built-in.
let _BUILTIN_PARAMS = [{name: "a", default: None}, {name: "b", default: None}, {name: "c", default: None}]
|

def _builtin_value(name, env):
  if (_BUILTINS[name] == None && _EXT_BUILTINS[name] == None): error("Unknown function: " + name)
  else do
    let impl = _builtin_impl(name)
    | {kind: "fn", params: _BUILTIN_PARAMS, body: {kind: "builtin", name: name}, env: env,
        dflt: [None, None, None], req: 1,
        code: fn(value, call_env):
          let a = call_env["a"]
          | let b = call_env["b"]
          | let c = call_env["c"]
          | impl(a, b, c, if (c != None): 3 elif (b != None): 2 else: 1, value, call_env)
        end}
  end
end

# A name as a value: its binding, or a built-in as a function value.
def _comp_ident(ast):
  let name = ast[:name]
  | [true, fn(value, env):
      let v = env[name]
      | if (v == None && !has(env, name)): _builtin_value(name, env) else: v
    end]
end

# A name as a statement (pipe step, branch or body), where a function with at
# most one required parameter is called, with the piped value as its argument.
def _comp_ident_stmt(ast):
  let name = ast[:name]
  | [true, fn(value, env):
      let v = env[name]
      | if (v == None && !has(env, name)): _eval_builtin(name, [], value, env)
        elif (is_dict(v) && v[:kind] == "fn" && (if (v[:req] == None): _required_params(v[:params]) else: v[:req]) <= 1):
          _call_user_fn(v, [], value, env)
        else: v
    end]
end

# Compile a node in statement position.
def _comp_stmt(ast):
  if (ast[:kind] == "ident"): _comp_ident_stmt(ast) else: _comp(ast)
end

# ── calls ─────────────────────────────────────────────────────────────────────

# A user function's value-only body code. Functions built by `fn`/`def` carry
# theirs; one assembled by hand from AST nodes is compiled on first use.
def _body_code(fn_val):
  let run = fn_val[:code]
  | if (run == None): _as_body(_comp_stmt(fn_val[:body])) else: run
end

# Value-only code for the default expression of the i-th parameter.
def _default_code(fn_val, i):
  let compiled = fn_val[:dflt]
  | if (compiled == None): _as_v(_comp(fn_val[:params][i][:default])) else: compiled[i]
end

# Run a user function's body / a parameter's default expression.
def _call_body(fn_val, value, env):
  let run = _body_code(fn_val)
  | run(value, env)
end

def _call_default(fn_val, i, value, env):
  let run = _default_code(fn_val, i)
  | run(value, env)
end

def _compile_defaults(params):
  foreach (p, params):
    if (p[:default] == None): None else: _as_body(_comp(p[:default]))
  end
end

# Call a user function with one already-evaluated argument. A one-parameter
# function needs neither an argument array nor the general binding loop. The
# recursive name binding precedes the parameter so a parameter can shadow it.
def _call_user_fn1(fn_val, arg, value, env):
  let params = fn_val[:params]
  | if (len(params) == 1) do
        let fn_name = fn_val[:name]
        | let base_env = if (fn_name == None): fn_val[:env]
          else: set(fn_val[:env], fn_name, fn_val)
        | let run = fn_val[:code]
        | let call_env = set(base_env, params[0][:name], arg)
        | if (run == None): _call_body(fn_val, value, call_env)
          else: run(value, call_env)
      end
    else:
      _call_user_fn(fn_val, [arg], value, env)
end

# A call site resolves its built-in once, when compiled. At run time a user
# function bound under the same name in env takes precedence. Calls of up to
# three arguments pass them straight to the implementation without building
# an argument array.
def _comp_call(ast):
  let named_arity = _RECEIVER_ARITY[ast[:name]]
  | let arity = if (named_arity == None): _EXT_RECEIVER_ARITY[ast[:name]] else: named_arity
  | if (arity != None && len(ast[:args]) == arity - 1): _comp_receiver_call(ast)
    else: _comp_direct_call(ast)
end

# `xs | f(a)` for a built-in that takes its receiver first: the call's value is
# passed ahead of the written arguments. A user function bound under the same
# name still receives only the written arguments.
def _comp_receiver_call(ast):
  let name = ast[:name]
  | let impl = _builtin_impl(name)
  | let args = foreach (a, ast[:args]): _as_v(_comp(a)) end
  | if (len(args) == 1) do
      let a0 = args[0]
      | [true, fn(value, env):
          let named = env[name]
          | let x = a0(value, env)
          | if (named != None && has(named, "kind") && named[:kind] == "fn"):
              _call_user_fn1(named, x, value, env)
            else: impl(value, x, None, 2, value, env)
        end]
    end
    else do
      let a0 = args[0]
      | let a1 = args[1]
      | [true, fn(value, env):
          let named = env[name]
          | let x = a0(value, env)
          | let y = a1(value, env)
          | if (named != None && has(named, "kind") && named[:kind] == "fn"):
              _call_user_fn(named, [x, y], value, env)
            else: impl(value, x, y, 3, value, env)
        end]
    end
end

# Call of a computed function value: `(fn(x): x + 1)(2)`, `fns[0](2)`.
def _comp_apply(ast):
  let fc = _as_v(_comp(ast[:callee]))
  | let args = foreach (a, ast[:args]): _as_v(_comp(a)) end
  | [true, fn(value, env):
      let f = fc(value, env)
      | if (is_dict(f) && has(f, "kind") && f[:kind] == "fn"):
          _call_user_fn(f, foreach (a, args): a(value, env) end, value, env)
        else: error("Value is not callable")
    end]
end

def _comp_direct_call(ast):
  let name = ast[:name]
  | let impl = _builtin_impl(name)
  | let args = foreach (a, ast[:args]): _as_v(_comp(a)) end
  | let n = len(args)
  | if (n == 0):
      [true, fn(value, env):
        let named = env[name]
        | if (named != None && has(named, "kind") && named[:kind] == "fn"):
            _call_user_fn(named, [], value, env)
          else: impl(value, None, None, 0, value, env)
      end]
    elif (n == 1) do
        let a0 = args[0]
        | [true, fn(value, env):
            let named = env[name]
            | let x = a0(value, env)
            | if (named != None && has(named, "kind") && named[:kind] == "fn"):
                _call_user_fn1(named, x, value, env)
              else: impl(x, None, None, 1, value, env)
          end]
      end
    elif (n == 2) do
        let a0 = args[0]
        | let a1 = args[1]
        | [true, fn(value, env):
            let named = env[name]
            | let x = a0(value, env)
            | let y = a1(value, env)
            | if (named != None && has(named, "kind") && named[:kind] == "fn"):
                _call_user_fn(named, [x, y], value, env)
              else: impl(x, y, None, 2, value, env)
          end]
      end
    elif (n == 3) do
        let a0 = args[0]
        | let a1 = args[1]
        | let a2 = args[2]
        | [true, fn(value, env):
            let named = env[name]
            | let x = a0(value, env)
            | let y = a1(value, env)
            | let z = a2(value, env)
            | if (named != None && has(named, "kind") && named[:kind] == "fn"):
                _call_user_fn(named, [x, y, z], value, env)
              else: impl(x, y, z, 3, value, env)
          end]
      end
    else:
      [true, fn(value, env):
        let named = env[name]
        | let args_vals = foreach (a, args): a(value, env) end
        | if (named != None && has(named, "kind") && named[:kind] == "fn"):
            _call_user_fn(named, args_vals, value, env)
          else: impl(args_vals[0], args_vals[1], args_vals[2], n, value, env)
      end]
end

# ── operators ─────────────────────────────────────────────────────────────────

# Value-only code for `left OP right` over value-only operands. Common
# operators use the host operation directly; the rest share _eval_bin.
def _bin_v(op, l, r):
  if (op == "+"): fn(value, env): l(value, env) + r(value, env) end
  elif (op == "-"): fn(value, env): l(value, env) - r(value, env) end
  elif (op == "*"): fn(value, env): l(value, env) * r(value, env) end
  elif (op == "/"): fn(value, env): l(value, env) / r(value, env) end
  elif (op == "%"): fn(value, env): l(value, env) % r(value, env) end
  elif (op == "=="): fn(value, env): l(value, env) == r(value, env) end
  elif (op == "!="): fn(value, env): l(value, env) != r(value, env) end
  elif (op == "<"): fn(value, env): l(value, env) < r(value, env) end
  elif (op == "<="): fn(value, env): l(value, env) <= r(value, env) end
  elif (op == ">"): fn(value, env): l(value, env) > r(value, env) end
  elif (op == ">="): fn(value, env): l(value, env) >= r(value, env) end
  elif (op == "&&"):
    fn(value, env):
      let lv = l(value, env)
      | if (!lv): false else: _eval_bin(op, lv, r(value, env))
    end
  elif (op == "||"):
    fn(value, env):
      let lv = l(value, env)
      | if (lv): lv else: _eval_bin(op, lv, r(value, env))
    end
  elif (op == "??"):
    fn(value, env):
      let lv = l(value, env)
      | if (lv != None): lv else: _eval_bin(op, lv, r(value, env))
    end
  else: fn(value, env): _eval_bin(op, l(value, env), r(value, env)) end
end

# Peel a left-associated chain of "bin" nodes into its first operand and an
# array of {op, right} stages, without recursing through the nesting.
def _unroll_bin(ast):
  var reversed = None
  | var count = 0
  | var cursor = ast
  | while (cursor[:kind] == "bin"):
      reversed = [{op: cursor[:op], right: cursor[:right]}, reversed]
      | cursor = cursor[:left]
      | count += 1
    end
  | let stages = foreach (i, range(0, count - 1)):
      let stage = reversed[0]
      | reversed = reversed[1]
      | stage
    end
  | {first: cursor, stages: stages}
end

# Value-only code for `left OP <number>` where OP is an eager operator (one
# of _ITEM_LITERAL_BIN_OPS): the literal is read from the AST once, so the
# right operand costs no call.
def _bin_v_const(op, l, r):
  if (op == "+"): fn(value, env): l(value, env) + r end
  elif (op == "-"): fn(value, env): l(value, env) - r end
  elif (op == "*"): fn(value, env): l(value, env) * r end
  elif (op == "/"): fn(value, env): l(value, env) / r end
  elif (op == "%"): fn(value, env): l(value, env) % r end
  elif (op == "=="): fn(value, env): l(value, env) == r end
  elif (op == "!="): fn(value, env): l(value, env) != r end
  elif (op == "<"): fn(value, env): l(value, env) < r end
  elif (op == "<="): fn(value, env): l(value, env) <= r end
  elif (op == ">"): fn(value, env): l(value, env) > r end
  else: fn(value, env): l(value, env) >= r end
end

def _comp_bin(ast):
  let left = ast[:left]
  | if (left[:kind] == "bin" && left[:left][:kind] == "bin") do
        let chain = _unroll_bin(ast)
        | _comp_bin_chain(chain[:first], chain[:stages])
      end
    else do
        let lc = _comp(left)
        | let rc = _comp(ast[:right])
        | let op = ast[:op]
        | if (lc[0] && rc[0] && ast[:right][:kind] == "num" && _ITEM_LITERAL_BIN_OPS[op]):
            [true, _bin_v_const(op, lc[1], ast[:right][:val])]
          elif (lc[0] && rc[0]):
            [true, _bin_v(op, lc[1], rc[1])]
          else do
              # Bindings made by the left operand are visible to the right one and
              # in the result env.
              let lx = _as_x(lc)
              | let rpure = rc[0]
              | let rrun = rc[1]
              | [false, fn(value, env):
                  let lr = lx(value, env)
                  | let lv = lr[:val]
                  | if (_ctrl(lr) != "none"): lr
                    elif (op == "&&" && !lv): {val: false, env: lr[:env]}
                    elif (op == "||" && lv): {val: lv, env: lr[:env]}
                    elif (op == "??" && lv != None): {val: lv, env: lr[:env]}
                    elif (rpure): {val: _eval_bin(op, lv, rrun(value, lr[:env])), env: lr[:env]}
                    else do
                        let rr = rrun(value, lr[:env])
                        | if (_ctrl(rr) != "none"): rr
                          else: {val: _eval_bin(op, lv, rr[:val]), env: rr[:env]}
                      end
                end]
            end
      end
end

# A long binary chain is a first operand plus a flat array of {op, right}
# stages, evaluated by a loop rather than by nested closure calls.
# Short-circuiting leaves the accumulator and env unchanged; a numeric
# literal operand is read straight from the AST.
def _comp_bin_chain(first_ast, stage_asts):
  let fc = _comp(first_ast)
  | var all_pure = fc[0]
  | let stages = foreach (s, stage_asts):
      let right = s[:right]
      | if (right[:kind] == "num"): [s[:op], true, true, right[:val]]
        else do
            let rc = _comp(right)
            | if (!rc[0]): all_pure = false
            | [s[:op], rc[0], false, rc[1]]
          end
    end
  | let n = len(stages)
  | if (all_pure) do
        let f = fc[1]
        | [true, fn(value, env):
            var acc = f(value, env)
            | var i = 0
            | while (i < n):
                let st = stages[i]
                | let op = st[0]
                | if (op == "&&" && !acc): acc = false
                  elif (op == "||" && acc): None
                  elif (op == "??" && acc != None): None
                  else do
                      let rv = if (st[2]): st[3] else: st[3](value, env)
                      | if (op == "+"): acc = acc + rv
                        else: acc = _eval_bin(op, acc, rv)
                    end
                | i += 1
              end
            | acc
          end]
      end
    else do
        let fx = _as_x(fc)
        | [false, fn(value, env):
            let first = fx(value, env)
            | var acc = first[:val]
            | var cur_env = first[:env]
            | var signal = if (_ctrl(first) == "none"): None else: first
            | var i = 0
            | while (i < n && signal == None):
                let st = stages[i]
                | let op = st[0]
                | if (op == "&&" && !acc): acc = false
                  elif (op == "||" && acc): None
                  elif (op == "??" && acc != None): None
                  elif (st[1]) do
                      let rv = if (st[2]): st[3] else: st[3](value, cur_env)
                      | acc = _eval_bin(op, acc, rv)
                    end
                  else do
                      let rr = st[3](value, cur_env)
                      | if (_ctrl(rr) != "none"): signal = rr
                        else do
                          acc = _eval_bin(op, acc, rr[:val])
                          | cur_env = rr[:env]
                        end
                    end
                | i += 1
              end
            | if (signal != None): signal else: {val: acc, env: cur_env}
          end]
      end
end

def _comp_un(ast):
  let c = _comp(ast[:expr])
  | let e = c[1]
  | let op = ast[:op]
  | if (c[0]):
      if (op == "!"): [true, fn(value, env): !e(value, env) end]
      elif (op == "-"): [true, fn(value, env): 0 - e(value, env) end]
      else: [true, e]
    else:
      [false, fn(value, env):
        let er = e(value, env)
        | let v = er[:val]
        | let nv = if (op == "!"): !v elif (op == "-"): 0 - v else: v
        | {val: nv, env: er[:env]}
      end]
end

# ── indexing ──────────────────────────────────────────────────────────────────

def _comp_idx(ast):
  let bc = _comp(ast[:base])
  | let ic = _comp(ast[:index])
  | if (bc[0] && ic[0]) do
        let b = bc[1]
        | let i = ic[1]
        | [true, fn(value, env): b(value, env)[i(value, env)] end]
      end
    else do
        let bx = _as_x(bc)
        | let ix = _as_x(ic)
        | [false, fn(value, env):
            let br = bx(value, env)
            | let ir = ix(value, br[:env])
            | {val: br[:val][ir[:val]], env: ir[:env]}
          end]
      end
end

def _comp_dkey(ast):
  let bc = _comp(ast[:base])
  | let key = ast[:key]
  | let b = bc[1]
  | if (bc[0]): [true, fn(value, env): b(value, env)[key] end]
    else:
      [false, fn(value, env):
        let br = b(value, env)
        | {val: br[:val][key], env: br[:env]}
      end]
end

def _comp_slice(ast):
  let bc = _comp(ast[:base])
  | let fc = _comp(ast[:from])
  | let has_to = ast[:to] != None
  | let tc = if (has_to): _comp(ast[:to]) else: _comp_const(None)
  | if (bc[0] && fc[0] && tc[0]) do
        let b = bc[1]
        | let f = fc[1]
        | let t = tc[1]
        | [true, fn(value, env):
            let base = b(value, env)
            | let from = f(value, env)
            | let to = if (has_to): t(value, env) else: len(base)
            | base[from:to]
          end]
      end
    else do
        let bx = _as_x(bc)
        | let fx = _as_x(fc)
        | let tx = _as_x(tc)
        | [false, fn(value, env):
            let br = bx(value, env)
            | let fr = fx(value, br[:env])
            | let tr = if (has_to): tx(value, fr[:env]) else: {val: len(br[:val]), env: fr[:env]}
            | {val: br[:val][fr[:val]:tr[:val]], env: tr[:env]}
          end]
      end
end

# ── collection literals and interpolation ─────────────────────────────────────

# [true, value] when `ast` is a literal built only from numbers, strings,
# booleans, None, atoms, and arrays and dictionaries of those; otherwise
# [false, None]. Values are immutable, so such a literal is built once, at
# compile time, and every evaluation returns the same value.
def _literal(ast):
  let k = ast[:kind]
  | if (k == "num" || k == "str" || k == "bool"): [true, ast[:val]]
    elif (k == "none"): [true, None]
    elif (k == "atom"): [true, ast[:name]]
    elif (k == "arr") do
        var ok = true
        | let vals = foreach (item, ast[:items]):
            let r = _literal(item)
            | if (!r[0]) do
                  ok = false
                  | break
                end
            | r[1]
          end
        | if (ok): [true, vals] else: [false, None]
      end
    elif (k == "dict") do
        var ok = true
        | let pairs = foreach (p, ast[:pairs]):
            let key = _literal(p[:key])
            | let val = _literal(p[:val])
            | if (!key[0] || !val[0]) do
                  ok = false
                  | break
                end
            | [key[1], val[1]]
          end
        | if (ok): [true, dict(pairs)] else: [false, None]
      end
    else: [false, None]
end

# Elements are evaluated for their value alone: a literal exports no bindings.
def _comp_arr(ast):
  let lit = _literal(ast)
  | if (lit[0]): _comp_const(lit[1])
    else: _comp_arr_items(ast)
end

def _comp_arr_items(ast):
  let items = foreach (a, ast[:items]): _as_v(_comp(a)) end
  | let n = len(items)
  | if (n == 0): [true, fn(value, env): [] end]
    elif (n == 1) do
        let a = items[0]
        | [true, fn(value, env): [a(value, env)] end]
      end
    elif (n == 2) do
        let a = items[0]
        | let b = items[1]
        | [true, fn(value, env): [a(value, env), b(value, env)] end]
      end
    elif (n == 3) do
        let a = items[0]
        | let b = items[1]
        | let c = items[2]
        | [true, fn(value, env): [a(value, env), b(value, env), c(value, env)] end]
      end
    else: [true, fn(value, env): foreach (c, items): c(value, env) end end]
end

# The host dict constructor inserts entries in order and replaces duplicate
# keys without copying the growing dict. Literal keys are fixed at compile
# time.
def _comp_dict(ast):
  let lit = _literal(ast)
  | if (lit[0]): _comp_const(lit[1])
    else: _comp_dict_pairs(ast)
end

def _comp_dict_pairs(ast):
  let pairs = ast[:pairs]
  | var literal_keys = true
  | foreach (p, pairs):
      if (p[:key][:kind] != "atom" && p[:key][:kind] != "str"): literal_keys = false
    end
  | if (literal_keys) do
        let slots = foreach (p, pairs):
          [if (p[:key][:kind] == "atom"): p[:key][:name] else: p[:key][:val], _as_v(_comp(p[:val]))]
        end
        | [true, fn(value, env): dict(foreach (s, slots): [s[0], s[1](value, env)] end) end]
      end
    else do
        let slots = foreach (p, pairs): [_as_v(_comp(p[:key])), _as_v(_comp(p[:val]))] end
        | [true, fn(value, env): dict(foreach (s, slots): [s[0](value, env), s[1](value, env)] end) end]
      end
end

def _comp_interp(ast):
  let parts = foreach (s, ast[:segs]):
    if (s[:kind] == "text"): [false, s[:val]]
    else: [true, _as_v(_comp(s[:node]))]
  end
  | [true, fn(value, env):
      join(foreach (p, parts):
        if (p[0]): to_string(p[1](value, env)) else: p[1]
      end, "")
    end]
end

# ── conditionals ──────────────────────────────────────────────────────────────

# Index of the first truthy condition, or n when none is.
def _first_true(conds, n, value, env):
  var i = 0
  | while (i < n && !conds[i](value, env)): i += 1 end
  | i
end

def _comp_if(ast):
  let cond = _as_v(_comp(ast[:cond]))
  | let tc = _comp_stmt(ast[:then])
  | let elifs = if (ast[:elifs] == None): [] else: ast[:elifs]
  | let ne = len(elifs)
  | let ac = if (ast[:else_br] == None): None else: _comp_stmt(ast[:else_br])
  | var pure = tc[0] && (ac == None || ac[0])
  | let conds = foreach (e, elifs): _as_v(_comp(e[:cond])) end
  | let ecs = foreach (e, elifs):
      let c = _comp_stmt(e[:body])
      | if (!c[0]): pure = false
      | c
    end
  | if (pure) do
        let t = tc[1]
        | let a = if (ac == None): None else: ac[1]
        | if (ne == 0):
            if (a == None): [true, fn(value, env): if (cond(value, env)): t(value, env) else: None end]
            else: [true, fn(value, env): if (cond(value, env)): t(value, env) else: a(value, env) end]
          else do
              let bodies = foreach (c, ecs): c[1] end
              | [true, fn(value, env):
                  if (cond(value, env)): t(value, env)
                  else do
                      let i = _first_true(conds, ne, value, env)
                      | if (i < ne): bodies[i](value, env)
                        elif (a == None): None
                        else: a(value, env)
                    end
                end]
            end
      end
    else do
        let tx = _as_x(tc)
        | let bodies = foreach (c, ecs): _as_x(c) end
        | let ax = if (ac == None): None else: _as_x(ac)
        | [false, fn(value, env):
            if (cond(value, env)): tx(value, env)
            else do
                let i = _first_true(conds, ne, value, env)
                | if (i < ne): bodies[i](value, env)
                  elif (ax == None): {val: None, env: env}
                  else: ax(value, env)
              end
          end]
      end
end

# unless (cond): body -- runs body only when cond is false, else yields None.
def _comp_unless(ast):
  let cond = _as_v(_comp(ast[:cond]))
  | let bc = _comp_stmt(ast[:body])
  | let b = bc[1]
  | if (bc[0]): [true, fn(value, env): if (!cond(value, env)): b(value, env) else: None end]
    else: [false, fn(value, env): if (!cond(value, env)): b(value, env) else: {val: None, env: env} end]
end

# ── pipes ─────────────────────────────────────────────────────────────────────

# Source-order stage nodes of a pipe. The parser stores them as an array;
# an AST built by hand may nest "pipe" nodes through left/right instead.
def _pipe_stage_asts(ast):
  if (ast[:stages] != None): ast[:stages]
  else do
      var reversed = None
      | var count = 0
      | var cursor = ast
      | while (cursor[:kind] == "pipe"):
          reversed = [cursor[:right], reversed]
          | cursor = cursor[:left]
          | count += 1
        end
      | let rest = foreach (i, range(0, count - 1)):
          let stage = reversed[0]
          | reversed = reversed[1]
          | stage
        end
      | [cursor] + rest
    end
end

# Identity stages (`.` and `self`) leave the value and environment in place,
# so they compile to nothing.
def _comp_pipe(ast):
  var all_pure = true
  | let cs = foreach (s, _pipe_stage_asts(ast)):
      if (s[:kind] == "dot" || s[:kind] == "self"): continue
      else do
          let c = _comp_stmt(s)
          | if (!c[0]): all_pure = false
          | c
        end
    end
  | let n = len(cs)
  | if (n == 0): [true, fn(value, env): value end]
    elif (n == 1): cs[0]
    elif (all_pure) do
        let codes = foreach (c, cs): c[1] end
        | if (n == 2) do
              let s0 = codes[0]
              | let s1 = codes[1]
              | [true, fn(value, env): s1(s0(value, env), env) end]
            end
          elif (n == 3) do
              let s0 = codes[0]
              | let s1 = codes[1]
              | let s2 = codes[2]
              | [true, fn(value, env): s2(s1(s0(value, env), env), env) end]
            end
          else:
            [true, fn(value, env):
              var acc = codes[0](value, env)
              | var i = 1
              | while (i < n):
                  acc = codes[i](acc, env)
                  | i += 1
                end
              | acc
            end]
      end
    else do
        let flags = foreach (c, cs): c[0] end
        | let codes = foreach (c, cs): c[1] end
        | let first_x = _as_x(cs[0])
        | [false, fn(value, env):
            let first = first_x(value, env)
            | var result_val = first[:val]
            | var result_env = first[:env]
            | var signal = _ctrl(first)
            | var i = 1
            | while (i < n && signal == "none"):
                if (flags[i]): result_val = codes[i](result_val, result_env)
                else do
                    let result = codes[i](result_val, result_env)
                    | result_val = result[:val]
                    | result_env = result[:env]
                    | signal = _ctrl(result)
                  end
                | i += 1
              end
            | if (signal == "none"): {val: result_val, env: result_env}
              else: {val: result_val, env: result_env, ctrl: signal}
          end]
      end
end

# ── bindings ──────────────────────────────────────────────────────────────────

# `let` and `var` both bind the value of their expression. Like every binding,
# they leave the piped value unchanged.
def _comp_let(ast):
  let name = ast[:name]
  | let vc = _comp(ast[:val])
  | let run = vc[1]
  | if (vc[0]):
      [false, fn(value, env):
        let v = run(value, env)
        | {val: value, env: set(env, name, v)}
      end]
    else:
      [false, fn(value, env):
        let vr = run(value, env)
        | if (_ctrl(vr) != "none"): vr
          else: {val: value, env: set(vr[:env], name, vr[:val])}
      end]
end

def _comp_destructure(ast):
  let pattern = ast[:pattern]
  | let vx = _as_x(_comp(ast[:val]))
  | [false, fn(value, env):
      let vr = vx(value, env)
      | if (_ctrl(vr) != "none"): vr
        else: {val: value, env: _bind_pattern(pattern, vr[:val], vr[:env])}
    end]
end

def _assign_value(op, cur_val, v):
  if (op == "="): v
  elif (op == "+="): cur_val + v
  elif (op == "-="): cur_val - v
  elif (op == "*="): cur_val * v
  elif (op == "/="): cur_val / v
  elif (op == "%="): cur_val % v
  elif (op == "//="): floor(cur_val / v)
  else: v
end

def _comp_assign(ast):
  let name = ast[:name]
  | let op = ast[:op]
  | let vc = _comp(ast[:val])
  | let run = vc[1]
  | if (vc[0]):
      [false, fn(value, env):
        let nv = _assign_value(op, env[name], run(value, env))
        | {val: value, env: set(env, name, nv)}
      end]
    else:
      [false, fn(value, env):
        let vr = run(value, env)
        | if (_ctrl(vr) != "none"): vr
          else do
            let nv = _assign_value(op, env[name], vr[:val])
            | {val: value, env: set(vr[:env], name, nv)}
          end
      end]
end

# ── functions ─────────────────────────────────────────────────────────────────

def _comp_fn(ast):
  let params = ast[:params]
  | let body = ast[:body]
  | let run = _as_body(_comp_stmt(body))
  | let dflt = _compile_defaults(params)
  | let req = _required_params(params)
  | [true, fn(value, env):
      {kind: "fn", params: params, body: body, env: env, code: run, dflt: dflt, req: req}
    end]
end

def _comp_def(ast):
  let name = ast[:name]
  | let params = ast[:params]
  | let body = ast[:body]
  | let run = _as_body(_comp_stmt(body))
  | let dflt = _compile_defaults(params)
  | let req = _required_params(params)
  | [false, fn(value, env):
      let fn_val = {kind: "fn", name: name, params: params, body: body, env: env, code: run, dflt: dflt, req: req}
      | {val: value, env: set(env, name, fn_val)}
    end]
end

# module name: body -- the body's new bindings are exposed as "name::binding".
# set() preserves key order and updates an existing key in place, only ever
# appending a genuinely new one at the end (verified against the host
# runtime). So the body's new bindings are exactly the tail of its resulting
# env past the outer env's original key count -- no need to check
# `has(env, nk)` per key, which costs O(env size) per lookup on this host's
# dict and made evaluating a module quadratic in the size of an
# already-large environment.
def _comp_module(ast):
  let name = ast[:name]
  | let bx = _as_x(_comp_stmt(ast[:body]))
  | [false, fn(value, env):
      let orig_len = len(keys(env))
      | let inner = bx(value, env)
      | let after_keys = keys(inner[:env])
      | let new_keys = after_keys[orig_len:len(after_keys)]
      | var new_env = env
      | var i = 0
      | while (i < len(new_keys)):
          new_env = set(new_env, name + "::" + new_keys[i], inner[:env][new_keys[i]])
          | i += 1
        end
      | {val: value, env: new_env}
    end]
end

# ── control flow ──────────────────────────────────────────────────────────────

# `break` without a value leaves its loop with the results gathered so far
# (signal "break_bare"); `break: expr` leaves it with expr's value ("break").
def _comp_break(ast):
  if (ast[:val] == None):
    [false, fn(value, env): {val: value, env: env, ctrl: "break_bare"} end]
  else do
      let vx = _as_x(_comp(ast[:val]))
      | [false, fn(value, env):
          let vr = vx(value, env)
          | {val: vr[:val], env: vr[:env], ctrl: "break"}
        end]
    end
end

def _comp_try(ast):
  let bc = _comp_stmt(ast[:body])
  | let cc = _comp_stmt(ast[:catch_body])
  | let catch_var = ast[:catch_var]
  | if (bc[0] && cc[0] && catch_var == None) do
        let b = bc[1]
        | let c = cc[1]
        | [true, fn(value, env):
            try:
              b(value, env)
            catch:
              c(value, env)
          end]
      end
    else do
        let bx = _as_x(bc)
        | let cx = _as_x(cc)
        | [false, fn(value, env):
            try:
              bx(value, env)
            catch(e):
              if (catch_var == None): cx(value, env)
              else: cx(value, set(env, catch_var, e))
          end]
      end
end

# `expr?` -- an error in expr yields None instead of propagating.
def _comp_trysuppress(ast):
  let tc = _comp(ast[:target])
  | let t = tc[1]
  | if (tc[0]):
      [true, fn(value, env):
        try:
          t(value, env)
        catch:
          None
      end]
    else:
      [false, fn(value, env):
        try:
          t(value, env)
        catch:
          {val: None, env: env}
      end]
end

# `until` stops when its condition becomes true; `while` stops when it
# becomes false; `loop` never stops by itself. Each iteration receives the
# previous iteration's value. The loop's value is that of the last completed
# iteration, None if there was none. Continue keeps the previous value but
# retains new bindings. A plain `break` leaves the previous iteration's value
# for `while` / `until`, but the value reaching the `break` for `loop`.
def _comp_cond_loop(ast, stop_when_true):
  let is_loop = ast[:kind] == "loop"
  | if (!is_loop && _signals(ast[:cond])): _comp_cond_loop_signalling_cond(ast, stop_when_true)
    else: _comp_cond_loop_plain(ast, stop_when_true)
end

# `while (if (c): break else: ...)`: the signal of the condition belongs to the
# enclosing loop, so this loop ends with it as its own result.
def _comp_cond_loop_signalling_cond(ast, stop_when_true):
  let condx = _as_x(_comp(ast[:cond]))
  | let bx = _as_x(_comp_stmt(_prepare(ast[:body])))
  | [false, fn(value, env):
      var cur_env = env
      | var cur_val = value
      | var out = None
      | var signal = None
      | var running = true
      | while (running):
          let cr = condx(cur_val, cur_env)
          | if (_ctrl(cr) != "none") do
                signal = cr
                | running = false
              end
            elif (cr[:val] == stop_when_true): running = false
            else do
              let br = bx(cur_val, cur_env)
              | let c = _ctrl(br)
              | cur_env = br[:env]
              | if (c == "break") do
                    out = br[:val]
                    | running = false
                  end
                elif (c == "break_bare"): running = false
                elif (c != "continue") do
                    cur_val = br[:val]
                    | out = cur_val
                  end
            end
        end
      | if (signal != None): signal else: {val: out, env: cur_env}
    end]
end

def _comp_cond_loop_plain(ast, stop_when_true):
  let is_loop = ast[:kind] == "loop"
  | let cond = if (is_loop): fn(value, env): true end else: _as_body(_comp(ast[:cond]))
  | let bc = _comp_stmt(_prepare(ast[:body]))
  | let body = bc[1]
  | if (bc[0]):
      # A pure body can neither bind nor signal, so only the value advances.
      [false, fn(value, env):
        var cur_val = value
        | var out = if (is_loop): value else: None
        | var running = cond(cur_val, env) != stop_when_true
        | while (running):
            cur_val = body(cur_val, env)
            | out = cur_val
            | running = cond(cur_val, env) != stop_when_true
          end
        | {val: out, env: env}
      end]
    else:
      [false, fn(value, env):
        var cur_env = env
        | var cur_val = value
        | var out = if (is_loop): value else: None
        | var running = cond(cur_val, cur_env) != stop_when_true
        | while (running):
            let br = body(cur_val, cur_env)
            | let c = _ctrl(br)
            | cur_env = br[:env]
            | if (c == "break") do
                  out = br[:val]
                  | running = false
                end
              elif (c == "break_bare"): running = false
              else do
                  if (c != "continue") do
                      cur_val = br[:val]
                      | out = cur_val
                    end
                  | running = cond(cur_val, cur_env) != stop_when_true
                end
          end
        | {val: out, env: cur_env}
      end]
end

# ── foreach ───────────────────────────────────────────────────────────────────
#
# Uses the host's own `foreach` (rather than a manual `var results = [] |
# while(...): results += [...] end` loop) so the accumulator gets the VM's
# dedicated collect-in-place fast path instead of a fresh array copy on every
# iteration -- the difference is O(n) vs. O(n²) for large inputs. `break`
# inside the host foreach genuinely stops iterating (not just a cheap
# per-item skip), so it also short-circuits the interpreted loop for free.

# A body of the form `item OP <number>` reads only its parameter. Its
# evaluation needs no per-item environment binding for eager operators.
def _is_item_literal_bin(body, name):
  body[:kind] == "bin" && body[:left][:kind] == "ident" &&
  body[:left][:name] == name && body[:right][:kind] == "num" &&
    _ITEM_LITERAL_BIN_OPS[body[:op]]
end

# Apply `item OP literal` to every item and bind the final item once after
# collecting results, instead of copying the environment for every item.
def _foreach_literal_bin(iter_var, iter_val, op, right, env):
  let results = foreach (item, iter_val):
    _eval_bin(op, item, right)
  end
  | {val: results, env: if (len(iter_val) == 0): env else: set(env, iter_var, last(iter_val))}
end

# A body that cannot bind or signal has its result collected directly. The
# loop variable stays bound to the last item afterwards, as in _foreach_env.
def _foreach_values(iter_var, iter_val, run, env):
  var cur_env = env
  | let results = foreach (item, iter_val):
      cur_env = set(env, iter_var, item)
      | run(item, cur_env)
    end
  | {val: results, env: cur_env}
end

def _foreach_env(iter_var, iter_val, run, env):
  var cur_env = env
  | var broke = false
  | var brk_val = None
  | let results = foreach (item, iter_val):
      let loop_env = set(cur_env, iter_var, item)
      | let br = run(item, loop_env)
      | let signal = br[:ctrl]
      | cur_env = br[:env]
      | if (signal == None || signal == "none"):
          br[:val]
        elif (signal == "break") do
            brk_val = br[:val]
            | broke = true
            | break
          end
        elif (signal == "break_bare"):
          break
        elif (signal == "continue"):
          continue
        else:
          br[:val]
    end
  | if (broke): {val: brk_val, env: cur_env}
    else: {val: results, env: cur_env}
end

def _comp_foreach(ast):
  let iter_var = ast[:iter_var]
  | let body = _prepare(ast[:body])
  | let body_kind = body[:kind]
  | let ic = _as_body(_comp(ast[:iter]))
  | let bc = _comp_stmt(body)
  | let run = bc[1]
  | let bpure = bc[0]
  # An identity body can reuse the input array. A bound None is excluded from
  # the identifier case because evaluating the identifier then tries builtin
  # lookup instead.
  | let identity = body_kind == "dot" || body_kind == "self"
  | let item_body = body_kind == "ident" && body[:name] == iter_var
  | let lit_bin = _is_item_literal_bin(body, iter_var)
  | let lit_op = if (lit_bin): body[:op] else: None
  | let lit_right = if (lit_bin): body[:right][:val] else: None
  | [false, fn(value, env):
      let iter_val = ic(value, env)
      | if (is_array(iter_val) && (identity || (item_body && !contains(iter_val, None)))):
          {val: iter_val, env: if (len(iter_val) == 0): env else: set(env, iter_var, last(iter_val))}
        elif (is_array(iter_val) && lit_bin):
          _foreach_literal_bin(iter_var, iter_val, lit_op, lit_right, env)
        elif (bpure): _foreach_values(iter_var, iter_val, run, env)
        else: _foreach_env(iter_var, iter_val, run, env)
    end]
end

# ── match ─────────────────────────────────────────────────────────────────────

# A literal arm over a number, string, boolean, or None compares directly
# against its AST value, so a long run of non-matching literals does not
# allocate a result dictionary per arm.
def _comp_match(ast):
  let vx = _as_x(_comp(ast[:val]))
  | let arms = foreach (arm, ast[:arms]):
      let pattern = arm[:pattern]
      | let literal = if (pattern[:kind] == "litpat"): pattern[:val] else: None
      | let literal_kind = if (literal == None): None else: literal[:kind]
      | let guard_signals = arm[:guard] != None && _signals(arm[:guard])
      | let direct = literal_kind == "num" || literal_kind == "str" || literal_kind == "bool" || literal_kind == "none"
      | {
          pattern: pattern,
          direct: direct,
          literal: if (literal_kind == "none" || !direct): None else: literal[:val],
          guard: if (arm[:guard] == None || guard_signals): None else: _as_v(_comp(arm[:guard])),
          gx: if (guard_signals): _as_x(_comp(arm[:guard])) else: None,
          body: _as_x(_comp_stmt(arm[:body])),
        }
    end
  | let n = len(arms)
  | [false, fn(value, env):
      let vr = vx(value, env)
      | let matchval = vr[:val]
      | let match_env = vr[:env]
      | var i = 0
      | var result = None
      | var signal = None
      | while (i < n && result == None && signal == None):
          let arm = arms[i]
          | let guard = arm[:guard]
          | if (arm[:gx] != None) do
                # A guard that can signal leaves the match with the signal.
                let mr = _match_pattern(arm[:pattern], matchval, match_env)
                | if (mr[:matched]) do
                      let gr = arm[:gx](value, mr[:env])
                      | if (_ctrl(gr) != "none"): signal = gr
                        elif (gr[:val]): result = arm[:body](value, mr[:env])
                    end
              end
            elif (arm[:direct]) do
                if (matchval == arm[:literal] && (guard == None || guard(value, match_env))):
                  result = arm[:body](value, match_env)
              end
            else do
                let mr = _match_pattern(arm[:pattern], matchval, match_env)
                | if (mr[:matched] && (guard == None || guard(value, mr[:env]))):
                    result = arm[:body](value, mr[:env])
              end
          | i += 1
        end
      | if (signal != None): signal
        elif (result == None): error("No match arm matched")
        else: result
    end]
end

# ── break / continue inside an operand ───────────────────────────────────────
#
# A signal raised in the middle of an expression, as in `[if (c): break else:
# x, 9]` or `len(if (c): continue else: x)`, must reach the enclosing loop. Only
# statement positions (pipe stages, branches, `do` / `try` bodies) pass a signal
# on, so before compiling, a program that contains `break` or `continue` is
# rewritten: an operand that can signal is evaluated first into a temporary and
# the operator is applied to the temporary. A `hoist` node performs that
# evaluation and returns the signal as soon as one is raised.

def _is_signal_kind(k):
  k == "break" || k == "continue"
end

# True when the AST holds a break or continue anywhere.
def _has_ctrl(x):
  if (is_array(x)) do
      var found = false
      | var i = 0
      | let n = len(x)
      | while (!found && i < n):
          found = _has_ctrl(x[i])
          | i += 1
        end
      | found
    end
  elif (is_dict(x)) do
      let k = x[:kind]
      | if (k == "break" || k == "continue"): true
        else do
          let vs = values(x)
          | var found = false
          | var i = 0
          | let n = len(vs)
          | while (!found && i < n):
              found = _has_ctrl(vs[i])
              | i += 1
            end
          | found
        end
    end
  else: false
end

# True when evaluating the node can return a break or continue signal.
def _signals(n):
  let k = n[:kind]
  | if (k == "break" || k == "continue" || k == "hoist"): true
    elif (k == "pipe"): len(filter(n[:stages], fn(c): _signals(c) end)) > 0
    elif (k == "if") do
        _signals(n[:then]) || (n[:else_br] != None && _signals(n[:else_br])) ||
          len(filter(if (n[:elifs] == None): [] else: n[:elifs], fn(e): _signals(e[:body]) end)) > 0
      end
    elif (k == "bin"): _is_lazy_op(n[:op]) && _signals(n[:right])
    elif (k == "bin_chain"):
      len(filter(n[:stages], fn(st): _is_lazy_op(st[:op]) && _signals(st[:right]) end)) > 0
    elif (k == "while" || k == "until"): _signals(n[:cond])
    elif (k == "unless" || k == "do"): _signals(n[:body])
    elif (k == "try"): _signals(n[:body]) || _signals(n[:catch_body])
    elif (k == "match") do
        len(filter(n[:arms], fn(a): _signals(a[:body]) || (a[:guard] != None && _signals(a[:guard])) end)) > 0
      end
    else: false
end

# Leaves read no state a sibling could change, so they never need hoisting.
def _is_leaf_kind(k):
  k == "num" || k == "str" || k == "bool" || k == "none" || k == "atom" ||
    k == "ident" || k == "self" || k == "dot" || k == "nodes" || k == "sel"
end

def _hoist_name(depth, i):
  "%h" + to_string(depth) + "_" + to_string(i)
end

# Operands evaluated in order. Everything up to the last one that can signal is
# evaluated ahead of the operator, in its original order.
# Returns {items: operands with temporaries in place, binds: [{name, expr}]}.
def _hoist_items(items, depth):
  var last = -1
  | var i = 0
  | foreach (item, items):
      if (item != None && _signals(item)): last = i
      | i += 1
    end
  | if (last < 0): {items: items, binds: []}
    else do
      var binds = []
      | var idx = 0
      | let out = foreach (item, items):
          let at = idx
          | idx += 1
          | if (at > last || item == None || _is_leaf_kind(item[:kind])): item
            else do
              let name = _hoist_name(depth, at)
              | binds += [{name: name, expr: item}]
              | {kind: "ident", name: name}
            end
        end
      | {items: out, binds: binds}
    end
end

def _hoisted(binds, body):
  if (len(binds) == 0): body else: {kind: "hoist", binds: binds, body: body}
end

def _is_lazy_op(op):
  op == "&&" || op == "||" || op == "??"
end

# Rewrite one node whose children are already rewritten.
def _lift_node(n, depth):
  let k = n[:kind]
  | if (k == "call") do
      let h = _hoist_items(n[:args], depth)
      | _hoisted(h[:binds], set(n, "args", h[:items]))
    end
    elif (k == "apply") do
        let h = _hoist_items([n[:callee]] + n[:args], depth)
        | var at = -1
        | let args = foreach (a, h[:items]):
            at += 1
            | if (at == 0): continue else: a
          end
        | _hoisted(h[:binds], set(set(n, "callee", h[:items][0]), "args", args))
      end
    elif (k == "arr") do
        let h = _hoist_items(n[:items], depth)
        | _hoisted(h[:binds], set(n, "items", h[:items]))
      end
    elif (k == "dict") do
        let h = _hoist_items(foreach (p, n[:pairs]): p[:val] end, depth)
        | var at = -1
        | let pairs = foreach (p, n[:pairs]):
            at += 1
            | set(p, "val", h[:items][at])
          end
        | _hoisted(h[:binds], set(n, "pairs", pairs))
      end
    elif (k == "bin") do
        if (_is_lazy_op(n[:op])) do
            let h = _hoist_items([n[:left]], depth)
            | _hoisted(h[:binds], set(n, "left", h[:items][0]))
          end
        else do
            let h = _hoist_items([n[:left], n[:right]], depth)
            | _hoisted(h[:binds], set(set(n, "left", h[:items][0]), "right", h[:items][1]))
          end
      end
    elif (k == "bin_chain") do
        # Operands up to the first short-circuit operator, whose right side is lazy.
        let total = len(n[:stages])
        | var eager = total
        | var j = 0
        | foreach (st, n[:stages]):
            if (eager == total && _is_lazy_op(st[:op])): eager = j
            | j += 1
          end
        | var seen = 0
        | let rights = foreach (st, n[:stages]):
            seen += 1
            | if (seen > eager): continue else: st[:right]
          end
        | let h = _hoist_items([n[:first]] + rights, depth)
        | var at = 0
        | let stages = foreach (st, n[:stages]):
            at += 1
            | if (at <= eager): set(st, "right", h[:items][at]) else: st
          end
        | _hoisted(h[:binds], set(set(n, "first", h[:items][0]), "stages", stages))
      end
    elif (k == "un") do
        let h = _hoist_items([n[:expr]], depth)
        | _hoisted(h[:binds], set(n, "expr", h[:items][0]))
      end
    elif (k == "idx") do
        let h = _hoist_items([n[:base], n[:index]], depth)
        | _hoisted(h[:binds], set(set(n, "base", h[:items][0]), "index", h[:items][1]))
      end
    elif (k == "dkey") do
        let h = _hoist_items([n[:base]], depth)
        | _hoisted(h[:binds], set(n, "base", h[:items][0]))
      end
    elif (k == "slice") do
        let h = _hoist_items([n[:base], n[:from], n[:to]], depth)
        | _hoisted(h[:binds], set(set(set(n, "base", h[:items][0]), "from", h[:items][1]), "to", h[:items][2]))
      end
    elif (k == "interp") do
        let exprs = foreach (sg, n[:segs]):
            if (sg[:kind] == "expr"): sg[:node] else: None
          end
        | let h = _hoist_items(exprs, depth)
        | var at = -1
        | let segs = foreach (sg, n[:segs]):
            at += 1
            | if (sg[:kind] == "expr"): set(sg, "node", h[:items][at]) else: sg
          end
        | _hoisted(h[:binds], set(n, "segs", segs))
      end
    elif (k == "let" || k == "var" || k == "assign" || k == "let_destructure" || k == "var_destructure" || k == "break") do
        if (n[:val] == None): n
        else do
            let h = _hoist_items([n[:val]], depth)
            | _hoisted(h[:binds], set(n, "val", h[:items][0]))
          end
      end
    elif (k == "unless") do
        let h = _hoist_items([n[:cond]], depth)
        | _hoisted(h[:binds], set(n, "cond", h[:items][0]))
      end
    elif (k == "if") do
        let elifs = if (n[:elifs] == None): [] else: n[:elifs]
        | var split = -1
        | var j = 0
        | foreach (e, elifs):
            if (split < 0 && _signals(e[:cond])): split = j
            | j += 1
          end
        | if (split < 0) do
              let h = _hoist_items([n[:cond]], depth)
              | _hoisted(h[:binds], set(n, "cond", h[:items][0]))
            end
          else do
              # `elif` conditions run only when the earlier ones fail, so the
              # rest of the chain moves into the `else` of a nested `if`.
              var at = -1
              | let before = foreach (e, elifs):
                  at += 1
                  | if (at >= split): continue else: e
                end
              | at = -1
              | let after = foreach (e, elifs):
                  at += 1
                  | if (at <= split): continue else: e
                end
              | let inner = _lift_node({kind: "if", cond: elifs[split][:cond], then: elifs[split][:body],
                  elifs: after, else_br: n[:else_br]}, depth + 1)
              | _lift_node({kind: "if", cond: n[:cond], then: n[:then], elifs: before, else_br: inner}, depth)
            end
      end
    elif (k == "foreach") do
        let h = _hoist_items([n[:iter]], depth)
        | _hoisted(h[:binds], set(n, "iter", h[:items][0]))
      end
    elif (k == "match") do
        let h = _hoist_items([n[:val]], depth)
        | _hoisted(h[:binds], set(n, "val", h[:items][0]))
      end
    else: n
end

# Rewrite every node of the tree, children first. `depth` keeps temporaries of
# nested rewrites apart.
def _lift_tree(x, depth):
  if (is_array(x)): map(x, fn(item): _lift_tree(item, depth + 1) end)
  elif (is_dict(x)) do
      let rebuilt = dict(map(entries(x), fn(e): [e[0], _lift_tree(e[1], depth + 1)] end))
      | if (x[:kind] == None): rebuilt else: _lift_node(rebuilt, depth)
    end
  else: x
end

# The AST of a loop body to compile: unchanged unless it holds a break or
# continue. Lifting is idempotent, so an inner loop of a lifted body is a no-op.
def _prepare(ast):
  if (_has_ctrl(ast)): _lift_tree(ast, 0) else: ast
end

# Evaluate `binds` in order, then the body with the results bound. A signal
# raised by a bind ends the node at once and is returned as its result.
def _comp_hoist(ast):
  let names = foreach (b, ast[:binds]): b[:name] end
  | let codes = foreach (b, ast[:binds]): _as_x(_comp(b[:expr])) end
  | let body = _as_x(_comp(ast[:body]))
  | let n = len(codes)
  | [false, fn(value, env):
      var cur_env = env
      | var signal = None
      | var i = 0
      | while (i < n && signal == None):
          let r = codes[i](value, cur_env)
          | if (_ctrl(r) != "none"): signal = r
            else do
              cur_env = set(cur_env, names[i], r[:val])
              | i += 1
            end
        end
      | if (signal != None): signal else: body(value, cur_env)
    end]
end

# ── dispatch ──────────────────────────────────────────────────────────────────

def _comp(ast):
  let k = ast[:kind]
  | if (k == "ident"): _comp_ident(ast)
    elif (k == "num" || k == "str" || k == "bool"): _comp_const(ast[:val])
    elif (k == "call"): _comp_call(ast)
    elif (k == "apply"): _comp_apply(ast)
    elif (k == "hoist"): _comp_hoist(ast)
    elif (k == "bin"): _comp_bin(ast)
    elif (k == "bin_chain"): _comp_bin_chain(ast[:first], ast[:stages])
    elif (k == "pipe"): _comp_pipe(ast)
    elif (k == "if"): _comp_if(ast)
    elif (k == "self" || k == "dot"): [true, fn(value, env): value end]
    elif (k == "none"): _comp_const(None)
    elif (k == "atom"): _comp_const(ast[:name])
    elif (k == "nodes"): [true, fn(value, env): env["__nodes__"] end]
    elif (k == "sel") do
        let name = ast[:name]
        | let pred = _sel_pred(name)
        | let host = if (pred == None): _HOST_SELECTORS[name] else: None
        | if (pred != None): [true, fn(value, env): _apply_sel(pred, value) end]
          elif (host != None): [true, fn(value, env): _apply_host_sel(host, value) end]
          else: [true, fn(value, env): error("Unknown selector: ." + name) end]
      end
    elif (k == "un"): _comp_un(ast)
    elif (k == "arr"): _comp_arr(ast)
    elif (k == "dict"): _comp_dict(ast)
    elif (k == "idx"): _comp_idx(ast)
    elif (k == "dkey"): _comp_dkey(ast)
    elif (k == "slice"): _comp_slice(ast)
    elif (k == "interp"): _comp_interp(ast)
    elif (k == "let" || k == "var"): _comp_let(ast)
    elif (k == "assign"): _comp_assign(ast)
    elif (k == "let_destructure" || k == "var_destructure"): _comp_destructure(ast)
    elif (k == "fn"): _comp_fn(ast)
    elif (k == "def"): _comp_def(ast)
    elif (k == "do"): _comp_stmt(ast[:body])
    elif (k == "unless"): _comp_unless(ast)
    elif (k == "while"): _comp_cond_loop(ast, false)
    elif (k == "until"): _comp_cond_loop(ast, true)
    elif (k == "loop"): _comp_cond_loop(ast, false)
    elif (k == "foreach"): _comp_foreach(ast)
    elif (k == "break"): _comp_break(ast)
    elif (k == "continue"): [false, fn(value, env): {val: value, env: env, ctrl: "continue"} end]
    elif (k == "try"): _comp_try(ast)
    elif (k == "trysuppress"): _comp_trysuppress(ast)
    elif (k == "match"): _comp_match(ast)
    elif (k == "module"): _comp_module(ast)
    else: [true, fn(value, env): error("Unknown AST kind: " + to_string(k)) end]
end

# ── public entry points ───────────────────────────────────────────────────────

# Compile an AST once; the result can be passed to mq_eval any number of
# times without compiling again.
# Top-level code: a break or continue that no loop caught is an error.
def _top_code(ast):
  let run = _as_x(_comp_stmt(ast))
  | fn(value, env):
      let r = run(value, env)
      | if (_ctrl(r) == "none"): r else: _stray_signal(r)
    end
end

def mq_compile(ast):
  {kind: "compiled", ast: ast, run: _top_code(ast)}
end

# Evaluate an AST node (or a mq_compile result), returning
# {val: <result>, env: <env>}.
def mq_eval(ast, value, env):
  if (ast[:kind] == "compiled"): ast[:run](value, env)
  else do
      let run = _top_code(ast)
      | run(value, env)
    end
end

# Top-level eval: returns just the value (not the {val,env} pair).
def mq_eval_v(ast, value, env):
  if (ast[:kind] == "compiled"): ast[:run](value, env)[:val]
  else do
      let run = _top_code(ast)
      | run(value, env)[:val]
    end
end
