# mqmq/eval.mq
# Evaluator for the mq AST, written in mq.
#
# The evaluator uses mq's own built-in functions to perform operations,
# so it is a meta-interpreter layered on top of the real mq runtime.
#
# The AST is compiled once into closures (see "compilation to closures"
# below), and the closures are run against a value and an environment.
#
# mq_eval(ast, value, env) → {val: <result>, env: <updated_env>}
#   ast   - AST node produced by parser.mq, or a mq_compile result
#   value - current "self" value flowing through the pipeline
#   env   - dict of variable bindings {name: value, ...}
#
# mq_compile(ast) compiles an AST ahead of time. Evaluate the result any
# number of times without compiling again.

import "yaml"
| let _HEADING_NAMES = {h1: true, h2: true, h3: true, h4: true, h5: true, h6: true}
| let _ITEM_LITERAL_BIN_OPS = {
    "+": true, "-": true, "*": true, "/": true, "%": true,
    "==": true, "!=": true, "<": true, "<=": true, ">": true, ">=": true,
  }
|

# ── environment helpers ───────────────────────────────────────────────────────

# Bind a name in the environment, returning the new env.
def _env_set(env, name, val):
  set(env, name, val)
end

# Read the control-flow signal ("none" | "break" | "continue") off an eval result.
def _ctrl(r):
  if (r[:ctrl] == None): "none" else: r[:ctrl]
end

# Bind an array or dict destructuring pattern (see parser.mq's "arraypat" /
# "dictpat" nodes) against a value, returning the updated env. Batch large
# patterns; constructing the binding list costs more than set() for small ones.
def _bind_pattern(pat, val, env):
  if (pat[:kind] == "arraypat") do
      let names = pat[:names]
      | let value_len = len(val)
      | if (len(names) >= 32) do
            let bindings = map(range(0, len(names) - 1), fn(i):
              [names[i], if (i < value_len): val[i] else: None]
            end)
            | let with_rest = if (pat[:rest] == None): bindings
              else: bindings + [[pat[:rest], if (len(names) < value_len): val[len(names):value_len] else: []]]
            | dict(entries(env) + with_rest)
          end
        else do
            var e = env
            | var i = 0
            | while (i < len(names)):
                e = _env_set(e, names[i], if (i < value_len): val[i] else: None)
                | i += 1
              end
            | if (pat[:rest] != None):
                e = _env_set(e, pat[:rest], if (len(names) < value_len): val[len(names):value_len] else: [])
            | e
          end
    end
  else do
      let names = pat[:names]
      | if (len(names) >= 32) do
            let bindings = map(names, fn(name): [name, val[name]] end)
            | dict(entries(env) + bindings)
          end
        else do
            var e = env
            | var i = 0
            | while (i < len(names)):
                e = _env_set(e, names[i], val[names[i]])
                | i += 1
              end
            | e
          end
    end
end

# ── match / pattern matching ────────────────────────────────────────────────

def _match_type(name, val):
  if (name == "string"): is_string(val)
  elif (name == "number"): is_number(val)
  elif (name == "array"): is_array(val)
  elif (name == "dict"): is_dict(val)
  elif (name == "bool"): is_bool(val)
  elif (name == "none"): val == None
  else: false
end

# Value of a literal pattern. Parsed literals are number, string, boolean, or
# None nodes, read straight from the AST; any other node is compiled.
def _lit_value(lit, val, env):
  let k = lit[:kind]
  | if (k == "num" || k == "str" || k == "bool"): lit[:val]
    elif (k == "none"): None
    else: mq_eval(lit, val, env)[:val]
end

# Try to match `val` against a single pattern node, returning
# {matched: bool, env: <env with any bindings applied>}.
def _match_pattern(pat, val, env):
  let k = pat[:kind]
  | if (k == "wildpat"):
      {matched: true, env: env}
    elif (k == "bindpat"):
      {matched: true, env: _env_set(env, pat[:name], val)}
    elif (k == "typepat"):
      {matched: _match_type(pat[:name], val), env: env}
    elif (k == "litpat"):
      {matched: val == _lit_value(pat[:val], val, env), env: env}
    elif (k == "orpat") do
        let lr = _match_pattern(pat[:left], val, env)
        | if (lr[:matched]): lr else: _match_pattern(pat[:right], val, env)
      end
    elif (k == "arraypat") do
        if (!is_array(val)) do
            {matched: false, env: env}
          end
        elif (pat[:rest] == None && len(pat[:names]) != len(val)) do
            {matched: false, env: env}
          end
        elif (pat[:rest] != None && len(val) < len(pat[:names])) do
            {matched: false, env: env}
          end
        else do
            {matched: true, env: _bind_pattern(pat, val, env)}
          end
      end
    elif (k == "dictpat") do
        if (!is_dict(val)): {matched: false, env: env}
        else: {matched: true, env: _bind_pattern(pat, val, env)}
      end
    else:
      {matched: false, env: env}
end

# ── apply a closure (fn node) to arguments ───────────────────────────────────

# Apply a single-arg fn closure to one argument.
def _apply1(fn_val, arg, env):
  let p = if (len(fn_val[:params]) == 0): "_" else: fn_val[:params][0][:name]
  | let call_env = set(fn_val[:env], p, arg)
  | _call_body(fn_val, arg, call_env)
end

# Left-fold arr with fn(acc, item), starting from init. (Backs `fold`; done by
# hand with a while loop.)
def _fold(arr, init, fn_val, env):
  if (has(fn_val, "kind") && fn_val[:kind] == "fn" && len(arr) > 0) do
      let params = fn_val[:params]
      | let p1 = if (len(params) > 0): params[0][:name] else: "_"
      | let p2 = if (len(params) > 1): params[1][:name] else: "_"
      | let closure_env = fn_val[:env]
      | let body = _body_code(fn_val)
      | var acc = init
      | var i = 0
      | let n = len(arr)
      | while (i < n):
          let item = arr[i]
          | acc = body(acc, set(set(closure_env, p1, acc), p2, item))
          | i += 1
        end
      | acc
    end
  else do
      var acc = init
      | var i = 0
      | let n = len(arr)
      | while (i < n):
          acc = _apply2(fn_val, acc, arr[i], env)
          | i += 1
        end
      | acc
    end
end

# Apply a two-arg fn closure.
def _apply2(fn_val, a1, a2, env):
  let params = fn_val[:params]
  | let p1 = if (len(params) > 0): params[0][:name] else: "_"
  | let p2 = if (len(params) > 1): params[1][:name] else: "_"
  | let call_env = set(set(fn_val[:env], p1, a1), p2, a2)
  | _call_body(fn_val, a1, call_env)
end

# ── Markdown filters ────────────────────────────────────────────────────

# Make a wikilink from a scalar, or from every item in an array.  This returns
# ordinary Markdown text rather than a parsed node because mq's native runtime
# has a wikilink selector but no corresponding node constructor.
def _wikilink(value):
  if (is_array(value)):
    map(value, fn(item): _wikilink(item) end)
  else:
    "[[" + to_string(value) + "]]"
end

# Serialize a value as one YAML property.  Collections are indented beneath
# the property key; scalar values stay on the same line.  `yaml_stringify` is
# delegated to mq's standard yaml module, rather than reimplemented here.
def _yaml_property(value, key):
  let yaml = yaml::yaml_stringify(value)
  | if (is_array(value) || is_dict(value)):
      key + ":\n" + indent(yaml, "  ")
    else:
      key + ": " + yaml
end

# ── selector evaluation ───────────────────────────────────────────────────────

# Predicate for a named selector, or None for an unknown name.
def _sel_pred(name):
  if (name == "h1"): fn(node): is_h1(node) end
  elif (name == "h2"): fn(node): is_h2(node) end
  elif (name == "h3"): fn(node): is_h3(node) end
  elif (name == "h4"): fn(node): is_h4(node) end
  elif (name == "h5"): fn(node): is_h5(node) end
  elif (name == "h6"): fn(node): is_h6(node) end
  elif (name == "h"): fn(node): _HEADING_NAMES[to_md_name(node)] != None end
  elif (name == "code"): fn(node): is_code(node) end
  elif (name == "list" || name == "list_item"): fn(node): is_list(node) end
  elif (name == "table_cell"): fn(node): is_table_cell(node) end
  elif (name == "table_align"): fn(node): is_table_align(node) end
  elif (name == "table"): fn(node): is_table_cell(node) || is_table_align(node) end
  elif (name == "blockquote"): fn(node): to_md_name(node) == "blockquote" end
  elif (name == "thematic_break"): fn(node): to_md_name(node) == "Horizontal_rule" end
  elif (name == "html"): fn(node): is_html(node) end
  elif (name == "definition"): fn(node): to_md_name(node) == "definition" end
  else: None
end

# Selectors without an interpreter-specific implementation apply the host's
# selector to each node. A node it does not match yields None and is dropped.
let _HOST_SELECTORS = {
  "text": fn(node): node | .text end,
  "align": fn(node): node | .align end,
  "alt": fn(node): node | .alt end,
  "break": fn(node): node | .break end,
  "callout": fn(node): node | .callout end,
  "checked": fn(node): node | .checked end,
  "children": fn(node): node | .children end,
  "code_inline": fn(node): node | .code_inline end,
  "column": fn(node): node | .column end,
  "delete": fn(node): node | .delete end,
  "depth": fn(node): node | .depth end,
  "done": fn(node): node | .done end,
  "embed": fn(node): node | .embed end,
  "emphasis": fn(node): node | .emphasis end,
  "end_line": fn(node): node | .end_line end,
  "fence": fn(node): node | .fence end,
  "footnote": fn(node): node | .footnote end,
  "footnote_ref": fn(node): node | .footnote_ref end,
  "heading": fn(node): node | .heading end,
  "horizontal_rule": fn(node): node | .horizontal_rule end,
  "ident": fn(node): node | .ident end,
  "image": fn(node): node | .image end,
  "image_ref": fn(node): node | .image_ref end,
  "index": fn(node): node | .index end,
  "inline_math": fn(node): node | .inline_math end,
  "kind": fn(node): node | .kind end,
  "label": fn(node): node | .label end,
  "lang": fn(node): node | .lang end,
  "level": fn(node): node | .level end,
  "line": fn(node): node | .line end,
  "link": fn(node): node | .link end,
  "link_ref": fn(node): node | .link_ref end,
  "math": fn(node): node | .math end,
  "math_inline": fn(node): node | .math_inline end,
  "mdx_flow_expression": fn(node): node | .mdx_flow_expression end,
  "mdx_js_esm": fn(node): node | .mdx_js_esm end,
  "mdx_jsx_flow_element": fn(node): node | .mdx_jsx_flow_element end,
  "mdx_jsx_text_element": fn(node): node | .mdx_jsx_text_element end,
  "mdx_text_expression": fn(node): node | .mdx_text_expression end,
  "meta": fn(node): node | .meta end,
  "name": fn(node): node | .name end,
  "ordered": fn(node): node | .ordered end,
  "row": fn(node): node | .row end,
  "strong": fn(node): node | .strong end,
  "task": fn(node): node | .task end,
  "title": fn(node): node | .title end,
  "todo": fn(node): node | .todo end,
  "toml": fn(node): node | .toml end,
  "url": fn(node): node | .url end,
  "value": fn(node): node | .value end,
  "values": fn(node): node | .values end,
  "wikilink": fn(node): node | .wikilink end,
  "yaml": fn(node): node | .yaml end,
}
|

# Apply a host selector to a node or to every node of an array, keeping what it finds.
def _apply_host_sel(f, value):
  let found = map(if (is_array(value)): value else: [value], f)
  | filter(found, fn(r): r != None end)
end

# Filter a value (array of nodes or a single node) by a selector predicate.
def _apply_sel(pred, value):
  if (is_array(value)):
    filter(value, pred)
  elif (pred(value)):
    [value]
  else:
    []
end

# ── built-in functions ────────────────────────────────────────────────────────

# `map(items, f)` for a function value `f`. A body of the form `item OP
# <number>` reads only its parameter, so it needs no per-item environment.
def _builtin_map(items, f, env):
  if (has(f, "kind") && f[:kind] == "fn" && len(items) > 0) do
      let p = if (len(f[:params]) == 0): "_" else: f[:params][0][:name]
      | let body = f[:body]
      | if (_is_item_literal_bin(body, p)) do
            let op = body[:op]
            | let right = body[:right][:val]
            | map(items, fn(item): _eval_bin(op, item, right) end)
          end
        else do
            let closure_env = f[:env]
            | let run = _body_code(f)
            | map(items, fn(item): run(item, set(closure_env, p, item)) end)
          end
    end
  else:
    map(items, fn(item): _apply1(f, item, env) end)
end

def _builtin_filter(items, f, env):
  if (has(f, "kind") && f[:kind] == "fn" && len(items) > 0) do
      let p = if (len(f[:params]) == 0): "_" else: f[:params][0][:name]
      | let body = f[:body]
      | if (_is_item_literal_bin(body, p)) do
            let op = body[:op]
            | let right = body[:right][:val]
            | filter(items, fn(item): _eval_bin(op, item, right) end)
          end
        else do
            let closure_env = f[:env]
            | let run = _body_code(f)
            | filter(items, fn(item): run(item, set(closure_env, p, item)) end)
          end
    end
  else:
    filter(items, fn(item): _apply1(f, item, env) end)
end

# Every built-in as `fn(a0, a1, a2, n, value, env)`: the first three argument
# values (a0 is the current value when there are no arguments, a1 and a2 are
# None when missing), the argument count, and the call's value and env. The
# table is indexed once per call site, when the call is compiled, instead of
# scanning a chain of name comparisons on every call.
let _BUILTINS = {
  "len": fn(a0, a1, a2, n, value, env): len(a0) end,
  "pow": fn(a0, a1, a2, n, value, env): pow(a0, a1) end,

  # Type predicates
  "is_empty": fn(a0, a1, a2, n, value, env): is_empty(a0) end,
  "is_array": fn(a0, a1, a2, n, value, env): is_array(a0) end,
  "is_dict": fn(a0, a1, a2, n, value, env): is_dict(a0) end,
  "is_string": fn(a0, a1, a2, n, value, env): is_string(a0) end,
  "is_number": fn(a0, a1, a2, n, value, env): is_number(a0) end,
  "is_bool": fn(a0, a1, a2, n, value, env): is_bool(a0) end,
  "is_none": fn(a0, a1, a2, n, value, env): a0 == None end,

  # Markdown node type predicates
  "is_h1": fn(a0, a1, a2, n, value, env): is_h1(a0) end,
  "is_h2": fn(a0, a1, a2, n, value, env): is_h2(a0) end,
  "is_h3": fn(a0, a1, a2, n, value, env): is_h3(a0) end,
  "is_h4": fn(a0, a1, a2, n, value, env): is_h4(a0) end,
  "is_h5": fn(a0, a1, a2, n, value, env): is_h5(a0) end,
  "is_h6": fn(a0, a1, a2, n, value, env): is_h6(a0) end,
  "is_h": fn(a0, a1, a2, n, value, env): is_h(a0) end,
  "is_code": fn(a0, a1, a2, n, value, env): is_code(a0) end,
  "is_list": fn(a0, a1, a2, n, value, env): is_list(a0) end,
  "is_list_item": fn(a0, a1, a2, n, value, env): is_list(a0) end,
  "is_table_cell": fn(a0, a1, a2, n, value, env): is_table_cell(a0) end,
  "is_table_align": fn(a0, a1, a2, n, value, env): is_table_align(a0) end,
  "is_table": fn(a0, a1, a2, n, value, env): is_table_cell(a0) || is_table_align(a0) end,
  "is_blockquote": fn(a0, a1, a2, n, value, env): to_md_name(a0) == "blockquote" end,
  "is_thematic_break": fn(a0, a1, a2, n, value, env): to_md_name(a0) == "Horizontal_rule" end,
  "is_html": fn(a0, a1, a2, n, value, env): is_html(a0) end,
  "is_definition": fn(a0, a1, a2, n, value, env): to_md_name(a0) == "definition" end,

  # Conversion
  "to_text": fn(a0, a1, a2, n, value, env): to_text(a0) end,
  "to_string": fn(a0, a1, a2, n, value, env): to_string(a0) end,
  "to_number": fn(a0, a1, a2, n, value, env): to_number(a0) end,
  "to_bool": fn(a0, a1, a2, n, value, env):
    a0 == true || (is_number(a0) && a0 != 0) || (is_string(a0) && !is_empty(a0))
  end,

  # Collection inspection
  "first": fn(a0, a1, a2, n, value, env): first(a0) end,
  "last": fn(a0, a1, a2, n, value, env): last(a0) end,
  "keys": fn(a0, a1, a2, n, value, env): keys(a0) end,
  "values": fn(a0, a1, a2, n, value, env): values(a0) end,
  "entries": fn(a0, a1, a2, n, value, env): entries(a0) end,

  # Collection construction / transformation
  "range": fn(a0, a1, a2, n, value, env):
    if (n == 1): range(a0) else: range(a0, a1)
  end,
  "flatten": fn(a0, a1, a2, n, value, env): flatten(a0) end,
  "compact": fn(a0, a1, a2, n, value, env): compact(a0) end,
  "unique": fn(a0, a1, a2, n, value, env): unique_by(a0, fn(x): x end) end,
  "sort": fn(a0, a1, a2, n, value, env): sort(a0) end,
  "reverse": fn(a0, a1, a2, n, value, env): reverse(a0) end,
  "head": fn(a0, a1, a2, n, value, env):
    let piped = n == 1 && is_number(a0) && is_array(value)
    | let arr = if (piped): value else: a0
    | let count = if (piped): a0 elif (a1 == None): 1 else: a1
    | arr[0:count]
  end,
  "tail": fn(a0, a1, a2, n, value, env):
    let piped = n == 1 && is_number(a0) && is_array(value)
    | let arr = if (piped): value else: a0
    | let count = if (piped): a0 elif (a1 == None): 1 else: a1
    | let ln = len(arr)
    | let from = if (ln - count < 0): 0 else: ln - count
    | arr[from:ln]
  end,
  "zip": fn(a0, a1, a2, n, value, env): zip(a0, a1) end,

  # Coroutine / lazy stream builtins (no interpreted `yield`, see Known Limitations).
  "is_coroutine": fn(a0, a1, a2, n, value, env): is_coroutine(a0) end,
  "to_coroutine": fn(a0, a1, a2, n, value, env): to_coroutine(a0) end,
  "collect": fn(a0, a1, a2, n, value, env): collect(a0) end,
  "stream_range": fn(a0, a1, a2, n, value, env):
    if (n == 2): stream_range(a0, a1) else: stream_range(a0, a1, a2)
  end,
  "next": fn(a0, a1, a2, n, value, env): next(a0) end,
  "close": fn(a0, a1, a2, n, value, env): close(a0) end,
  "iterables": fn(a0, a1, a2, n, value, env): iterables(a0) end,
  # 2-arity: `x | take(n)` (self as 1st arg) and `take(x, n)` (both explicit) both work.
  "send": fn(a0, a1, a2, n, value, env):
    if (n == 2): send(a0, a1) else: send(value, a0)
  end,
  "take": fn(a0, a1, a2, n, value, env):
    if (n == 2): take(a0, a1) else: take(value, a0)
  end,
  "skip": fn(a0, a1, a2, n, value, env):
    if (n == 2): skip(a0, a1) else: skip(value, a0)
  end,
  "take_while": fn(a0, a1, a2, n, value, env):
    let arr = if (n == 2): a0 else: value
    | let f = if (n == 2): a1 else: a0
    | take_while(arr, fn(item): _apply1(f, item, env) end)
  end,
  "skip_while": fn(a0, a1, a2, n, value, env):
    let arr = if (n == 2): a0 else: value
    | let f = if (n == 2): a1 else: a0
    | skip_while(arr, fn(item): _apply1(f, item, env) end)
  end,

  # Higher-order collection functions (a1 must be a fn closure)
  "map": fn(a0, a1, a2, n, value, env): _builtin_map(a0, a1, env) end,
  "filter": fn(a0, a1, a2, n, value, env): _builtin_filter(a0, a1, env) end,
  "flat_map": fn(a0, a1, a2, n, value, env): flat_map(a0, fn(item): _apply1(a1, item, env) end) end,
  "sort_by": fn(a0, a1, a2, n, value, env): sort_by(a0, fn(item): _apply1(a1, item, env) end) end,
  "group_by": fn(a0, a1, a2, n, value, env): group_by(a0, fn(item): _apply1(a1, item, env) end) end,
  "fold": fn(a0, a1, a2, n, value, env): _fold(a0, a1, a2, env) end,
  "each": fn(a0, a1, a2, n, value, env): each(a0, fn(item): _apply1(a1, item, env) end) end,
  "any": fn(a0, a1, a2, n, value, env): any(a0, fn(item): _apply1(a1, item, env) end) end,
  "all": fn(a0, a1, a2, n, value, env): all(a0, fn(item): _apply1(a1, item, env) end) end,

  # Array mutation helpers
  "get": fn(a0, a1, a2, n, value, env): get(a0, a1) end,
  "set": fn(a0, a1, a2, n, value, env): set(a0, a1, a2) end,
  "del": fn(a0, a1, a2, n, value, env): del(a0, a1) end,
  "push": fn(a0, a1, a2, n, value, env): a0 + [a1] end,
  "pop": fn(a0, a1, a2, n, value, env): a0[0:len(a0) - 1] end,

  # String operations
  "contains": fn(a0, a1, a2, n, value, env): contains(a0, a1) end,
  "starts_with": fn(a0, a1, a2, n, value, env): starts_with(a0, a1) end,
  "ends_with": fn(a0, a1, a2, n, value, env): ends_with(a0, a1) end,
  "replace": fn(a0, a1, a2, n, value, env): replace(a0, a1, a2) end,
  "gsub": fn(a0, a1, a2, n, value, env): gsub(a0, a1, a2) end,
  "split": fn(a0, a1, a2, n, value, env): split(a0, a1) end,
  # `join(sep)`, `head(n)` and `tail(n)` take the piped array as receiver; an
  # array argument keeps the explicit form, where the separator or count is
  # optional.
  "join": fn(a0, a1, a2, n, value, env):
    if (n == 1 && is_array(value) && !is_array(a0)): join(value, a0)
    else: join(a0, if (a1 == None): "" else: a1)
  end,
  "trim": fn(a0, a1, a2, n, value, env): trim(a0) end,
  "ltrim": fn(a0, a1, a2, n, value, env): ltrim(a0) end,
  "rtrim": fn(a0, a1, a2, n, value, env): rtrim(a0) end,
  "upper": fn(a0, a1, a2, n, value, env): upcase(a0) end,
  "lower": fn(a0, a1, a2, n, value, env): downcase(a0) end,
  "regex_match": fn(a0, a1, a2, n, value, env): regex_match(a0, a1) end,

  # Math
  "abs": fn(a0, a1, a2, n, value, env): abs(a0) end,
  "floor": fn(a0, a1, a2, n, value, env): floor(a0) end,
  "ceil": fn(a0, a1, a2, n, value, env): ceil(a0) end,
  "round": fn(a0, a1, a2, n, value, env): round(a0) end,
  "min": fn(a0, a1, a2, n, value, env):
    if (n == 1): first(sort(a0)) else: min(a0, a1)
  end,
  "max": fn(a0, a1, a2, n, value, env):
    if (n == 1): last(sort(a0)) else: max(a0, a1)
  end,
  "sqrt": fn(a0, a1, a2, n, value, env): sqrt(a0) end,
  "log": fn(a0, a1, a2, n, value, env): ln(a0) end,

  # Node / markdown operations
  # select(v, cond): v when cond is truthy, else None (`v | select(cond)`).
  "select": fn(a0, a1, a2, n, value, env): if (a1): a0 else: None end,
  "attr": fn(a0, a1, a2, n, value, env): attr(a0, a1) end,
  "set_attr": fn(a0, a1, a2, n, value, env): set_attr(a0, a1, a2) end,
  "to_md_text": fn(a0, a1, a2, n, value, env): to_md_text(a0) end,
  "to_md_list": fn(a0, a1, a2, n, value, env): to_md_list(a0, a1) end,
  "to_html": fn(a0, a1, a2, n, value, env): to_html(a0) end,

  # Markdown construction and moku-compatible formatting filters.  The
  # short names take their value from the pipeline (`title | h1`), while the
  # `to_*` names retain mq's explicit-argument API.
  "to_h": fn(a0, a1, a2, n, value, env): to_h(a0, a1) end,
  "to_blockquote": fn(a0, a1, a2, n, value, env): to_blockquote(a0) end,
  "to_strong": fn(a0, a1, a2, n, value, env): to_strong(a0) end,
  "to_em": fn(a0, a1, a2, n, value, env): to_em(a0) end,
  "to_delete": fn(a0, a1, a2, n, value, env): to_delete(a0) end,
  "to_code": fn(a0, a1, a2, n, value, env): to_code(a0, a1) end,
  "to_code_inline": fn(a0, a1, a2, n, value, env): to_code_inline(a0) end,
  "h1": fn(a0, a1, a2, n, value, env): to_h(a0, 1) end,
  "h2": fn(a0, a1, a2, n, value, env): to_h(a0, 2) end,
  "h3": fn(a0, a1, a2, n, value, env): to_h(a0, 3) end,
  "h4": fn(a0, a1, a2, n, value, env): to_h(a0, 4) end,
  "h5": fn(a0, a1, a2, n, value, env): to_h(a0, 5) end,
  "h6": fn(a0, a1, a2, n, value, env): to_h(a0, 6) end,
  "blockquote": fn(a0, a1, a2, n, value, env): to_blockquote(a0) end,
  "bold": fn(a0, a1, a2, n, value, env): to_strong(a0) end,
  "italic": fn(a0, a1, a2, n, value, env): to_em(a0) end,
  "strike": fn(a0, a1, a2, n, value, env): to_delete(a0) end,
  "code_inline": fn(a0, a1, a2, n, value, env): to_code_inline(a0) end,
  "code": fn(a0, a1, a2, n, value, env): to_code(value, a0) end,
  "wikilink": fn(a0, a1, a2, n, value, env): _wikilink(a0) end,
  "yaml_property": fn(a0, a1, a2, n, value, env): _yaml_property(value, a0) end,

  # Control
  "error": fn(a0, a1, a2, n, value, env): error(a0) end,
  "debug": fn(a0, a1, a2, n, value, env): debug(a0) end,
  "env": fn(a0, a1, a2, n, value, env): env end,
}
# Built-ins whose first argument is the receiver and that always take exactly
# this many arguments. Called with one fewer, as in `xs | map(f)`, the call's
# value is filled in as the first argument. Built-ins with optional arguments
# or their own handling of a missing receiver (`take`, `join`, `head`, `to_h`,
# `to_code`, ...) are not listed.
| let _RECEIVER_ARITY = {
  "map": 2, "filter": 2, "flat_map": 2, "sort_by": 2, "group_by": 2,
  "each": 2, "any": 2, "all": 2, "split": 2, "contains": 2,
  "starts_with": 2, "ends_with": 2, "regex_match": 2, "get": 2, "del": 2,
  "push": 2, "attr": 2, "zip": 2, "select": 2,
  "fold": 3, "replace": 3, "gsub": 3, "set": 3, "set_attr": 3
}
|

# ── built-ins delegated to the host ─────────────────────────────────────────────
#
# These built-ins have no interpreter-specific behavior, so each one hands its
# arguments to the host function of the same name. The table is derived from the
# signatures `mq help <name>` prints. Functions that reach outside the query
# (files, network, processes, standard input, exit) are deliberately absent, as
# are those that return or take a variable number of functions.
# An mqmq function value passed as an argument is wrapped by _hf so the host can
# call it.

# A host function standing in for an mqmq function value (anything else is
# passed through). A user function takes as many arguments as it declares; a
# built-in used as a value takes `hint`, the number the host calls it with.
def _hf(f, env, hint):
  if (is_dict(f) && has(f, "kind") && f[:kind] == "fn") do
      let builtin = has(f, "body") && is_dict(f[:body]) && f[:body][:kind] == "builtin"
      | let k = if (builtin): hint else: len(f[:params])
      | if (k >= 3): fn(a, b, c): _call_user_fn(f, [a, b, c], None, env) end
        elif (k == 2): fn(a, b): _apply2(f, a, b, env) end
        else: fn(a): _apply1(f, a, env) end
    end
  else: f
end
|

let _EXT_BUILTINS = {
  "accumulate": fn(a0, a1, a2, n, value, env): if (n >= 3): accumulate(a0, a1, _hf(a2, env, 2)) elif (n == 2): accumulate(a0, a1) else: accumulate(a0) end,
  "acos": fn(a0, a1, a2, n, value, env): acos(a0) end,
