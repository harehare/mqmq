# Run with: mq-bench benchmarks_selectors.mq --iterations 3 --warmup 1
# The runner includes module setup in each iteration. Compare each case with
# the same case on another revision.

import "eval"
| let headings = map(range(0, 1023), fn(i): to_h("heading", 1) end)
| let h_ast = {kind: "sel", name: "h"}
| let h6_ast = {kind: "sel", name: "h6"}
| let text_ast = {kind: "sel", name: "text"}
|

def bench_selector_h6():
  eval::mq_eval(h6_ast, headings, {})[:val]
end

def bench_selector_text():
  eval::mq_eval(text_ast, headings, {})[:val]
end

def bench_selector_h_repeated():
  foreach (i, range(0, 99)):
    eval::mq_eval(h_ast, headings, {})[:val]
  end
end

def bench_selector_text_repeated():
  foreach (i, range(0, 99)):
    eval::mq_eval(text_ast, headings, {})[:val]
  end
end
