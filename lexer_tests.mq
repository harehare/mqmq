# mqmq/lexer_tests.mq
# Tests for the mqmq lexer, run with `mq-test lexer_tests.mq`.

import "lexer"
| include "test"

def _tok(t, v): {t: t, v: v} end
def _lex(q): filter(lexer::lex(q), fn(t): t[:t] != "eof" end) end

# @parametrize([
#   ["hello", [_tok("ident", "hello")]],
#   ["let", [_tok("kw", "let")]],
#   ["if", [_tok("kw", "if")]],
#   ["true", [_tok("bool", "true")]],
#   ["false", [_tok("bool", "false")]],
#   ["None", [_tok("none", "")]],
#   ["42", [_tok("num", "42")]],
#   ["3.14", [_tok("num", "3.14")]],
#   ["\"hi\"", [_tok("str", "hi")]],
#   [".h1", [_tok("sel", "h1")]],
#   [".h", [_tok("sel", "h")]],
#   [".", [_tok("dot", ".")]],
#   ["|", [_tok("op", "|")]],
#   ["||", [_tok("op", "||")]],
#   ["==", [_tok("op", "==")]],
#   ["!=", [_tok("op", "!=")]],
#   [":", [_tok("op", ":")]],
#   [":foo", [_tok("atom", "foo")]],
#   ["=~", [_tok("op", "=~")]],
#   ["!~", [_tok("op", "!~")]],
#   ["??", [_tok("op", "??")]],
#   ["nodes", [_tok("kw", "nodes")]],
#   ["..", [_tok("op", "..")]],
#   ["@", [_tok("op", "@")]],
#   ["//=", [_tok("op", "//=")]],
#   ["::", [_tok("op", "::")]],
#   ["module", [_tok("kw", "module")]],
#   ["\"-\"", [_tok("str", "-")]],
#   ["(x)", [_tok("op", "("), _tok("ident", "x"), _tok("op", ")")]],
#   ["a b", [_tok("ident", "a"), _tok("ident", "b")]],
#   ["<< >>", [_tok("op", "<<"), _tok("op", ">>")]],
#   ["break continue", [_tok("kw", "break"), _tok("kw", "continue")]],
#   ["try catch", [_tok("kw", "try"), _tok("kw", "catch")]],
#   ["until unless", [_tok("kw", "until"), _tok("kw", "unless")]],
#   ["1..5", [_tok("num", "1"), _tok("op", ".."), _tok("num", "5")]],
#   ["if (x): y", [
#     _tok("kw", "if"), _tok("op", "("), _tok("ident", "x"), _tok("op", ")"),
#     _tok("op", ":"), _tok("ident", "y"),
#   ]],
# ])
def test_lex(input, expected):
  assert_eq(_lex(input), expected)
end

def test_empty_query():
  assert_eq(_lex(""), [])
end

def test_long_whitespace_and_comment():
  let spaces = join(map(range(0, 255), fn(i): " \t\r\n" end), "")
  | assert_eq(_lex(spaces + "42" + spaces), [_tok("num", "42")])
  | assert_eq(_lex("#" + spaces + "\n42"), [_tok("num", "42")])
end

def test_all_multi_character_operators():
  let source = "+= -= *= /= %= //= |= -> && || == =~ != !~ <= << >= >> ?? :: .."
  | assert_eq(map(_lex(source), fn(tok): tok[:v] end), split(source, " "))
end

def test_long_plain_and_escaped_strings():
  let long = join(map(range(0, 255), fn(i): "abcdefgh" end), "")
  | assert_eq(_lex("\"" + long + "\"")[0], _tok("str", long))
  | assert_eq(_lex("\"a\\nb\"")[0], _tok("str", "a\nb"))
end

def test_unicode_graphemes():
  assert_eq(_lex("\"👩‍💻\" ☃ x"), [_tok("str", "👩‍💻"), _tok("op", "☃"), _tok("ident", "x")])
end

# -- interpolated strings (single istr token carrying parsed segments) --

def test_interp_string_is_single_token():
  assert_eq(len(_lex("s\"a${1+2}b\"")), 1)
end

def test_interp_string_segments():
  let toks = _lex("s\"a${1+2}b\"")
  | assert_eq(toks[0][:t], "istr")
  | assert_eq(toks[0][:v], [{kind: "text", val: "a"}, {kind: "expr", val: "1+2"}, {kind: "text", val: "b"}])
end

def test_interp_multiple_expressions():
  let toks = _lex("s\"abc${1}def${2}ghi\"")
  | assert_eq(toks[0][:v], [
      {kind: "text", val: "abc"}, {kind: "expr", val: "1"},
      {kind: "text", val: "def"}, {kind: "expr", val: "2"},
      {kind: "text", val: "ghi"},
    ])
end

def test_interp_escape_after_expression():
  let toks = _lex("s\"a${1}b\\nc\"")
  | assert_eq(toks[0][:v], [
      {kind: "text", val: "a"}, {kind: "expr", val: "1"},
      {kind: "text", val: "b\nc"},
    ])
end

def test_interp_escape_before_expression():
  let source = "s\"" + "a\\\"b" + "${1}c\""
  | let toks = _lex(source)
  | assert_eq(toks[0][:v], [
      {kind: "text", val: "a\"b"}, {kind: "expr", val: "1"},
      {kind: "text", val: "c"},
    ])
end

def test_interp_string_no_expr():
  let toks = _lex("s\"plain\"")
  | assert_eq(toks[0][:v], [{kind: "text", val: "plain"}])
end

def test_interp_brace_in_quoted_expression():
  let toks = _lex("s\"x${\"}\"}y\"")
  | assert_eq(toks[0][:v], [
      {kind: "text", val: "x"},
      {kind: "expr", val: "\"}\""},
      {kind: "text", val: "y"},
    ])
end

def test_interp_brace_in_comment():
  let toks = _lex("s\"x${1 # }\n + 2}y\"")
  | assert_eq(toks[0][:v], [
      {kind: "text", val: "x"},
      {kind: "expr", val: "1 # }\n + 2"},
      {kind: "text", val: "y"},
    ])
end

def test_interp_brace_in_crlf_comment():
  let toks = _lex("s\"x${1 # }\r\n + 2}y\"")
  | assert_eq(toks[0][:v], [
      {kind: "text", val: "x"},
      {kind: "expr", val: "1 # }\r\n + 2"},
      {kind: "text", val: "y"},
    ])
end

# -- regex lexeme fast path --
# lex() splits most queries with one regex call and falls back to the
# character scanner otherwise. Both must produce the same tokens.

# @parametrize([
#   ["1.5 1..5 1. .5 ..a .h1.text . . :: :a::b : a:b"],
#   ["\"\" '' \"a\\\"b\" 'a\\'b' \"a\\\\\" \"a\\nb\\tc\\q\" \"multi\nline\""],
#   ["\"unterminated"],
#   ["'u"],
#   ["\"a\\"],
#   ["x //= 2 // 3 /= 4 a=>b `$^@~\\ !x"],
#   ["a||b|=c&&d==e=~f!=g!~h<=i<<j>=k>>l+=m-=n->o*=p/=q%=r??s"],
#   ["# comment\n1 # c\r\n2\t\n\r"],
#   ["True False None true false nones"],
#   ["\"a\" + \"#\" + '.' # \"é\""],
#   ["\"日本語\" + \"見出し\""],
#   ["a é"],
#   ["\"\u{301}\""],
#   ["\"a\u{200d}b\" + \"👍🏽\""],
#   ["is\"x\" + has \"s\""],
#   ["1 +\u{c}2"],
#   ["{a: 1, \"b\": [1, 2]} | f(x)[0][:k][1:2]?"],
# ])
def test_lexeme_fast_path_matches_scanner(query):
  assert_eq(lexer::lex(query), lexer::_lex_chars(query))
end

def test_lexeme_fast_path_used():
  assert_eq(is_none(lexer::_lex_lexemes("let x = \"日本語\" | x + 1")), false)
end
